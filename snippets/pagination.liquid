{% doc %}
  Accessible pagination for collection, blog, and search results.

  @param {paginate} paginate - Paginate object
  @param {string} [class] - Optional extra class

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{% if paginate.pages > 1 %}
  <nav class="pagination {{ class }}" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list">
      <li>
        {% if paginate.previous %}
          <a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M20 12H5m0 0 5.5-5.5M5 12l5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% else %}
          <span class="pagination__link pagination__link--disabled" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
              <path d="M20 12H5m0 0 5.5-5.5M5 12l5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {% endif %}
      </li>

      {% for part in paginate.parts %}
        <li>
          {% if part.is_link %}
            <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
          {% elsif part.title == paginate.current_page %}
            <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
          {% else %}
            <span class="pagination__link pagination__link--ellipsis">{{ part.title }}</span>
          {% endif %}
        </li>
      {% endfor %}

      <li>
        {% if paginate.next %}
          <a class="pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% else %}
          <span class="pagination__link pagination__link--disabled" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
              <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {% endif %}
      </li>
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .pagination {
    margin-top: var(--space-xl);
  }
  .pagination__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.65rem;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-decoration: none;
    border: 1px solid var(--color-line);
    color: inherit;
  }
  .pagination__link--current {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-contrast);
  }
  .pagination__link--disabled,
  .pagination__link--ellipsis {
    opacity: 0.4;
  }
  .pagination__link:not(.pagination__link--disabled):not(.pagination__link--current):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
{% endstylesheet %}
