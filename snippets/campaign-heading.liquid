{% doc %}
  Campaign display heading — oversized sans, no italic split.

  @param {string} [label] - Solid campaign label
  @param {string} heading - Main heading
  @param {string} [subheading] - Optional short subcopy
  @param {string} [heading_tag] - h1-h3, default h2
  @param {string} [class] - Extra class
  @param {string} [align] - left or center

  @example
  {% render 'campaign-heading', label: 'Drop 01', heading: 'Oceania' %}
{% enddoc %}

{% liquid
  assign tag = heading_tag | default: 'h2'
  assign align = align | default: 'left'
%}

<div class="camp-head camp-head--{{ align }} {{ class }}">
  {% if label != blank %}
    <p class="camp-label" data-cut-in>{{ label }}</p>
  {% endif %}
  {% if heading != blank %}
    <{{ tag }} class="camp-head__title" data-cut-in style="--cut-delay: 0.05s">{{ heading }}</{{ tag }}>
  {% endif %}
  {% if subheading != blank %}
    <p class="camp-head__sub" data-cut-in style="--cut-delay: 0.1s">{{ subheading }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .camp-head {
    display: grid;
    gap: var(--space-sm);
  }
  .camp-head--center {
    text-align: center;
    justify-items: center;
  }
  .camp-label {
    display: inline-block;
    padding: 0.45rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    background: var(--color-accent);
    color: var(--color-contrast);
    margin: 0;
    width: fit-content;
  }
  .camp-head__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-weight: 700;
    font-size: var(--text-display);
    line-height: 0.88;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  .camp-head__sub {
    margin: 0;
    max-width: 36ch;
    font-size: var(--text-base);
    line-height: 1.45;
    font-weight: 400;
  }
{% endstylesheet %}
