{% doc %}
  Responsive background video with desktop/mobile sources and poster fallback.

  Renders a single video that plays a desktop source by default. theme.js swaps
  to the mobile source below the breakpoint without downloading both files.
  Supports lazy loading for below-fold films via the lazy parameter.

  @param {video} [desktop_video] - Shopify video object for desktop
  @param {string} [desktop_url] - mp4 URL fallback for desktop
  @param {video} [mobile_video] - Shopify video object for mobile
  @param {string} [mobile_url] - mp4 URL fallback for mobile
  @param {string} [poster] - Poster image URL
  @param {string} [classes] - Class string for the video element
  @param {boolean} [autoplay] - Muted loop autoplay when true
  @param {number} [breakpoint] - Max-width px for mobile source (default 750)
  @param {boolean} [lazy] - Defer source until near viewport when true

  @example
  {% render 'responsive-bg-video', classes: 'hero__bg', desktop_url: url, poster: poster, autoplay: true %}
{% enddoc %}

{% liquid
  assign d_url = ''
  if desktop_video != blank
    for s in desktop_video.sources
      if s.format == 'mp4' and d_url == blank
        assign d_url = s.url
      endif
    endfor
    if d_url == blank
      assign d_url = desktop_video.sources.first.url
    endif
  elsif desktop_url != blank
    assign d_url = desktop_url
  endif

  assign m_url = ''
  if mobile_video != blank
    for s in mobile_video.sources
      if s.format == 'mp4' and m_url == blank
        assign m_url = s.url
      endif
    endfor
    if m_url == blank
      assign m_url = mobile_video.sources.first.url
    endif
  elsif mobile_url != blank
    assign m_url = mobile_url
  endif

  if m_url == blank
    assign m_url = d_url
  endif

  assign lazy = lazy | default: false, allow_false: true
  assign autoplay = autoplay | default: false, allow_false: true
%}

<video
  class="{{ classes }}"
  {% if autoplay %}autoplay muted loop{% endif %}
  playsinline
  preload="{% if lazy %}none{% else %}metadata{% endif %}"
  poster="{{ poster }}"
  data-responsive-video
  data-desktop="{{ d_url }}"
  data-mobile="{{ m_url }}"
  data-breakpoint="{{ breakpoint | default: 750 }}"
  {% if lazy %}data-lazy-video{% endif %}
>
  {% unless lazy %}
    {% if desktop_video != blank %}
      {% for s in desktop_video.sources %}
        <source src="{{ s.url }}" type="{{ s.mime_type }}">
      {% endfor %}
    {% elsif desktop_url != blank %}
      <source src="{{ desktop_url }}" type="video/mp4">
    {% endif %}
  {% endunless %}
</video>
