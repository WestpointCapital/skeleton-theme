{% style %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --tracking-heading: {{ settings.type_heading_tracking }}px;
    --tracking-eyebrow: {{ settings.type_eyebrow_tracking }}px;
    --text-xs: 0.6875rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: clamp(1.25rem, 1.08rem + 0.7vw, 1.625rem);
    --text-2xl: clamp(1.75rem, 1.35rem + 1.6vw, 2.625rem);
    --text-3xl: clamp(2.25rem, 1.55rem + 2.8vw, 3.75rem);
    --text-4xl: clamp(3rem, 1.8rem + 4.8vw, 5.75rem);
    --text-hero: clamp(3.75rem, 2rem + 7vw, 8rem);
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --space-2xs: clamp(0.4rem, 0.35rem + 0.2vw, 0.5rem);
    --space-xs: clamp(0.7rem, 0.62rem + 0.3vw, 0.875rem);
    --space-sm: clamp(1rem, 0.85rem + 0.5vw, 1.25rem);
    --space-md: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    --space-lg: clamp(2.5rem, 1.8rem + 2.2vw, 3.75rem);
    --space-xl: clamp(4rem, 2.6rem + 4.5vw, 6.5rem);
    --space-2xl: clamp(6rem, 3.5rem + 7vw, 10rem);
    --space-3xl: clamp(8rem, 4rem + 10vw, 14rem);
    --section-spacing: clamp(5.5rem, 3rem + 8vw, 11rem);
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-navy: {{ settings.color_navy }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-soft: {{ settings.color_accent_soft }};
    --color-contrast: {{ settings.color_contrast }};
    --color-foreground-50: color-mix(in srgb, var(--color-foreground) 50%, transparent);
    --color-foreground-12: color-mix(in srgb, var(--color-foreground) 12%, transparent);
    --color-line: color-mix(in srgb, var(--color-foreground) 14%, transparent);
    --color-map-line: color-mix(in srgb, var(--color-accent) 30%, transparent);
    --color-luminous: color-mix(in srgb, var(--color-accent-soft) 36%, transparent);
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --duration: 0.6s;
    --focus-ring: 0 0 0 3px var(--color-background), 0 0 0 5px var(--color-accent);
  }

  @media (max-width: 749px) {
    :root {
      --page-margin: {{ settings.min_page_margin | at_most: 20 }}px;
    }
  }
{% endstyle %}
