{% doc %}
  Simple breadcrumb trail for product and collection pages.

  @param {collection} [collection] - Optional collection context
  @param {product} [product] - Optional product context
  @param {string} [class] - Optional extra class

  @example
  {% render 'breadcrumbs', collection: collection, product: product %}
{% enddoc %}

<nav class="breadcrumbs {{ class }}" aria-label="{{ 'general.breadcrumbs.label' | t }}">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
  {% if collection != blank %}
    <span aria-hidden="true">/</span>
    <a href="{{ collection.url }}">{{ collection.title }}</a>
  {% elsif product != blank and product.collections.first != blank %}
    <span aria-hidden="true">/</span>
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
  {% endif %}
  {% if product != blank %}
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title }}</span>
  {% endif %}
</nav>

{% stylesheet %}
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: var(--space-md);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-50);
  }
  .breadcrumbs a {
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-accent);
  }
{% endstylesheet %}
