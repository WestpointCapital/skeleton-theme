{% doc %}
  Shared section heading — campaign sans system.

  @param {string} [eyebrow] - Solid campaign label
  @param {string} [heading] - Main heading
  @param {string} [subheading] - Optional subcopy
  @param {string} [class] - Extra class
  @param {string} [align] - left or center

  @example
  {% render 'section-heading', eyebrow: 'Archive', heading: 'All drops' %}
{% enddoc %}

{% render 'campaign-heading',
  label: eyebrow,
  heading: heading,
  subheading: subheading,
  class: class,
  align: align
%}
