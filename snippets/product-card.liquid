{% doc %}
  Studio campaign product card for grids and rails.

  @param {product} product - Product to render
  @param {string} [drop_label] - Optional drop/collection label
  @param {string} [badge] - Optional badge override
  @param {string} [class] - Optional extra class
  @param {boolean} [lazy] - Whether to lazy-load the image (default true)

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign lazy = lazy | default: true, allow_false: true
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif

  assign card_drop = drop_label
  if card_drop == blank and product.metafields.custom.region != blank
    assign card_drop = product.metafields.custom.region.value.name | default: product.metafields.custom.region.value | default: product.metafields.custom.region
  endif

  assign card_badge = badge
  if card_badge == blank and product.metafields.custom.is_one_of_a_kind == true
    assign card_badge = 'products.badge.one_of_a_kind' | t
  endif
  if card_badge == blank and product.available == false
    assign card_badge = 'products.badge.gone' | t
  endif
%}

<a
  class="product-card {{ class }}{% unless product.available %} product-card--unavailable{% endunless %}"
  href="{{ product.url }}"
>
  <div class="product-card__media">
    {% if product.featured_media != blank %}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag:
          class: 'product-card__image',
          loading: loading,
          widths: '360, 540, 720, 900',
          sizes: '(min-width: 990px) 22vw, (min-width: 750px) 40vw, 70vw',
          alt: product.featured_media.alt | default: product.title
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' }}
    {% endif %}

    {% if card_badge != blank %}
      {% liquid
        assign badge_style = 'soft'
        if product.available == false
          assign badge_style = 'gone'
        endif
      %}
      {% render 'badge', text: card_badge, style: badge_style, class: 'product-card__badge' %}
    {% endif %}
  </div>

  <div class="product-card__info">
    {% if card_drop != blank %}
      <span class="product-card__drop">{{ card_drop }}</span>
    {% endif %}
    <h3 class="product-card__title">{{ product.title }}</h3>
    {% render 'price', product: product, class: 'product-card__price' %}
  </div>
</a>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
    min-width: 0;
    background: color-mix(in srgb, var(--field-ink) 3%, var(--color-background));
    padding: var(--space-sm);
  }
  .product-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--field-pearl);
  }
  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }
  .product-card__info {
    display: grid;
    gap: 0.35rem;
  }
  .product-card__drop {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .product-card__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .product-card--unavailable {
    opacity: 0.6;
  }
{% endstylesheet %}
