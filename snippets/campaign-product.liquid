{% doc %}
  Studio campaign product tile — flat field, no numbered index.

  @param {product} product - Product object
  @param {string} [drop_label] - Optional drop/collection label
  @param {string} [class] - Extra class
  @param {boolean} [lazy] - Lazy load image

  @example
  {% render 'campaign-product', product: product, drop_label: 'Oceania' %}
{% enddoc %}

{% liquid
  assign lazy = lazy | default: true, allow_false: true
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif

  assign drop = drop_label
  if drop == blank and product.metafields.custom.region != blank
    assign drop = product.metafields.custom.region.value.name | default: product.metafields.custom.region.value | default: product.metafields.custom.region
  endif
%}

<a
  class="camp-product {{ class }}{% unless product.available %} camp-product--sold{% endunless %}"
  href="{{ product.url }}"
>
  <div class="camp-product__stage">
    {% if product.featured_media != blank %}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          class: 'camp-product__img',
          loading: loading,
          widths: '360, 540, 720, 800',
          sizes: '(min-width: 990px) 25vw, 50vw',
          alt: product.featured_media.alt | default: product.title
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'camp-product__img camp-product__img--placeholder' }}
    {% endif %}
    {% unless product.available %}
      <span class="camp-product__sold">{{ 'products.sold_out' | t }}</span>
    {% endunless %}
  </div>
  <div class="camp-product__meta">
    {% if drop != blank %}
      <span class="camp-product__drop">{{ drop }}</span>
    {% endif %}
    <h3 class="camp-product__title">{{ product.title }}</h3>
    {% render 'price', product: product, class: 'camp-product__price' %}
  </div>
</a>

{% stylesheet %}
  .camp-product {
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    color: inherit;
    min-width: 0;
    height: 100%;
  }
  .camp-product__stage {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--field-pearl);
    overflow: hidden;
  }
  .camp-product__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .camp-product__sold {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.65rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
    background: var(--field-navy);
    color: var(--color-contrast);
  }
  .camp-product__meta {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-sm) 0 0;
  }
  .camp-product__drop {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .camp-product__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .camp-product--sold {
    opacity: 0.55;
  }
{% endstylesheet %}
