{% doc %}
  Renders a responsive image that might be wrapped in a link.

  When width, height and crop are provided, the image will be rendered
  with a fixed aspect ratio.

  @param {image} image - The image to be rendered
  @param {string} [url] - An optional destination URL for the image
  @param {string} [class] - Optional class to be added to the image wrapper
  @param {number} [width] - The highest resolution width of the image
  @param {number} [height] - The highest resolution height of the image
  @param {string} [crop] - The crop position of the image
  @param {string} [sizes] - Optional sizes attribute
  @param {string} [loading] - eager or lazy
  @param {string} [alt] - Optional alt text override

  @example
  {% render 'image', image: product.featured_image, width: 1200, sizes: '(min-width: 990px) 50vw, 100vw' %}
{% enddoc %}

{% liquid
  unless height
    assign width = width | default: image.width
  endunless

  if url
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif

  assign loading_attr = loading | default: 'lazy'
  assign alt_text = alt | default: image.alt | default: ''
%}

{% if image != blank %}
  <{{ wrapper }}
    class="image {{ class }}"
    {% if url %}
      href="{{ url }}"
    {% endif %}
  >
    {{
      image
      | image_url: width: width, height: height, crop: crop
      | image_tag:
        loading: loading_attr,
        widths: '360, 540, 720, 900, 1200, 1600, 2000',
        sizes: sizes | default: '100vw',
        alt: alt_text
    }}
  </{{ wrapper }}>
{% endif %}

{% stylesheet %}
  .image {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: auto;
  }

  .image > img {
    width: 100%;
    height: auto;
  }
{% endstylesheet %}
