{% liquid
  assign overlay = false
  if section.settings.transparent_on_home and template.name == 'index'
    assign overlay = true
  endif

  if section.settings.announcement != blank
    assign announcement_height = '2.25rem'
  else
    assign announcement_height = '0rem'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    display: block;
    position: sticky;
    top: calc(-1 * {{ announcement_height }});
    z-index: 100;
    width: 100%;
  }

  #shopify-section-{{ section.id }} > * {
    grid-column: unset;
  }

  {% if overlay %}
    #shopify-section-{{ section.id }} {
      margin-bottom: calc(-1 * (var(--header-height) + {{ announcement_height }}));
    }
  {% endif %}
{% endstyle %}

<header class="atlas-header{% if overlay %} atlas-header--overlay{% endif %}" data-header data-scrolled="false">
  {% if section.settings.announcement != blank %}
    <div class="atlas-header__announcement">
      <span aria-hidden="true">{{ section.settings.coordinate_west }}</span>
      <p>{{ section.settings.announcement }}</p>
      <span aria-hidden="true">{{ section.settings.coordinate_east }}</span>
    </div>
  {% endif %}

  <div class="atlas-header__bar">
    <div class="atlas-header__navigation">
      <button
        class="atlas-header__menu-button"
        type="button"
        aria-label="{{ 'general.open_menu' | t }}"
        aria-haspopup="dialog"
        aria-controls="MobileNavigation"
        data-menu-open
      >
        <span></span>
        <span></span>
      </button>

      <nav class="atlas-header__nav" aria-label="Primary navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>
    </div>

    <a class="atlas-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'atlas-header__logo',
            alt: shop.name,
            loading: 'eager',
            widths: '120, 240, 360, 480, 600',
            style: 'width: ' | append: section.settings.logo_width | append: 'px'
        }}
      {% else %}
        <span class="atlas-header__wordmark">{{ shop.name }}</span>
      {% endif %}
      <span class="atlas-header__edition" aria-hidden="true">Cartographic Gallery · V2</span>
    </a>

    <div class="atlas-header__tools">
      <a href="{{ routes.search_url }}" aria-label="Search">
        <span>Search</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor"/>
          <path d="m15.5 15.5 5 5" stroke="currentColor"/>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="Account">
          <span>Account</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="8" r="3.5" stroke="currentColor"/>
            <path d="M5.5 20c.5-4 2.6-6 6.5-6s6 2 6.5 6" stroke="currentColor"/>
          </svg>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items" data-cart-open>
        <span>Cart</span>
        <span class="atlas-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<dialog class="atlas-menu" id="MobileNavigation" aria-labelledby="MobileNavigationTitle" data-mobile-menu>
  <div class="atlas-menu__frame">
    <div class="atlas-menu__head">
      <div>
        <span class="atlas-menu__coordinate">{{ section.settings.coordinate_west }}</span>
        <p id="MobileNavigationTitle">{{ section.settings.menu_overlay_label }}</p>
      </div>
      <button type="button" aria-label="{{ 'general.close_menu' | t }}" data-menu-close>
        <span></span>
        <span></span>
      </button>
    </div>

    <nav class="atlas-menu__nav" aria-label="Mobile navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
          <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <strong>{{ link.title }}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      {% endfor %}
    </nav>

    <div class="atlas-menu__foot">
      <p>{{ section.settings.menu_overlay_footer }}</p>
      <a href="{{ routes.search_url }}">{{ 'search.title' | t }}</a>
    </div>
  </div>
</dialog>

{% stylesheet %}
  :root {
    --header-height: 6.75rem;
  }

  .atlas-header {
    position: relative;
    width: 100%;
    color: var(--color-foreground);
  }

  .atlas-header__announcement {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
    height: 2.25rem;
    padding-inline: var(--page-inline);
    color: var(--color-contrast);
    background: var(--color-navy);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .atlas-header__announcement span:last-child {
    text-align: right;
  }

  .atlas-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(12rem, 0.75fr) minmax(0, 1fr);
    align-items: stretch;
    min-height: var(--header-height);
    padding-inline: var(--page-inline);
    background: color-mix(in srgb, var(--color-background) 92%, transparent);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(22px);
    transition: background-color var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .atlas-header[data-scrolled="true"] .atlas-header__bar {
    background: color-mix(in srgb, var(--color-background) 97%, transparent);
    box-shadow: 0 1.5rem 4rem -3rem var(--color-navy);
  }

  .atlas-header__navigation,
  .atlas-header__tools {
    display: flex;
    align-items: center;
  }

  .atlas-header__navigation {
    padding-right: var(--space-md);
  }

  .atlas-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2.75rem);
  }

  .atlas-header__nav a,
  .atlas-header__tools a {
    text-decoration: none;
    text-transform: uppercase;
  }

  .atlas-header__nav a {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .atlas-header__nav a span {
    color: var(--color-accent);
    font-size: 0.5625rem;
    font-variant-numeric: tabular-nums;
  }

  .atlas-header__nav a::after {
    content: "";
    width: 100%;
    height: 1px;
    background: currentcolor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration) var(--ease);
  }

  .atlas-header__nav a:hover::after,
  .atlas-header__nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .atlas-header__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding-inline: var(--space-md);
    color: currentcolor;
    border-inline: 1px solid var(--color-line);
    text-align: center;
    text-decoration: none;
  }

  .atlas-header__wordmark {
    font-family: var(--font-heading--family);
    font-size: clamp(1.15rem, 1.5vw, 1.6rem);
    letter-spacing: 0.3em;
    line-height: 1;
    text-indent: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .atlas-header__edition {
    color: var(--color-accent);
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .atlas-header__logo {
    height: auto;
    max-width: 100%;
  }

  .atlas-header__tools {
    justify-content: flex-end;
    gap: clamp(0.9rem, 1.7vw, 1.8rem);
    padding-left: var(--space-md);
  }

  .atlas-header__tools a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .atlas-header__tools svg {
    width: 1rem;
    height: 1rem;
  }

  .atlas-header__cart-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.45rem;
    height: 1.45rem;
    padding-inline: 0.3rem;
    color: var(--color-contrast);
    background: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .atlas-header__menu-button {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.75rem;
    color: currentcolor;
    background: transparent;
    border: 1px solid var(--color-line);
  }

  .atlas-header__menu-button span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentcolor;
  }

  .atlas-header__menu-button span + span {
    width: 65%;
    margin-top: 0.45rem;
  }

  .atlas-header--overlay[data-scrolled="false"] {
    color: var(--color-contrast);
  }

  .atlas-header--overlay[data-scrolled="false"] .atlas-header__bar {
    background: transparent;
    border-color: color-mix(in srgb, var(--color-contrast) 24%, transparent);
    backdrop-filter: none;
  }

  .atlas-header--overlay[data-scrolled="false"] .atlas-header__brand,
  .atlas-header--overlay[data-scrolled="false"] .atlas-header__menu-button {
    border-color: color-mix(in srgb, var(--color-contrast) 24%, transparent);
  }

  .atlas-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    color: var(--color-contrast);
    background: var(--color-navy);
    border: 0;
  }

  .atlas-menu::backdrop {
    background: color-mix(in srgb, var(--color-navy) 70%, transparent);
    backdrop-filter: blur(8px);
  }

  .atlas-menu__frame {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100%;
    padding: var(--space-md) var(--page-margin);
    background-image:
      linear-gradient(90deg, transparent 49.8%, color-mix(in srgb, var(--color-accent-soft) 14%, transparent) 50%, transparent 50.2%),
      linear-gradient(color-mix(in srgb, var(--color-accent-soft) 12%, transparent) 1px, transparent 1px);
    background-size: 100% 100%, 100% 20vh;
  }

  .atlas-menu__head,
  .atlas-menu__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .atlas-menu__head {
    padding-bottom: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 20%, transparent);
  }

  .atlas-menu__head p,
  .atlas-menu__coordinate,
  .atlas-menu__foot {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .atlas-menu__coordinate {
    color: var(--color-accent-soft);
  }

  .atlas-menu__head button {
    position: relative;
    width: 3rem;
    height: 3rem;
    color: currentcolor;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-contrast) 30%, transparent);
  }

  .atlas-menu__head button span {
    position: absolute;
    top: 50%;
    left: 25%;
    width: 50%;
    height: 1px;
    background: currentcolor;
    transform: rotate(45deg);
  }

  .atlas-menu__head button span:last-child {
    transform: rotate(-45deg);
  }

  .atlas-menu__nav {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .atlas-menu__nav a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: baseline;
    gap: var(--space-sm);
    padding-block: clamp(0.8rem, 2vh, 1.5rem);
    color: currentcolor;
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 18%, transparent);
    text-decoration: none;
  }

  .atlas-menu__nav a > span {
    color: var(--color-accent-soft);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
  }

  .atlas-menu__nav strong {
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 10vw, 5rem);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .atlas-menu__foot {
    padding-top: var(--space-md);
    color: color-mix(in srgb, var(--color-contrast) 70%, transparent);
  }

  .atlas-menu__foot a {
    color: var(--color-contrast);
  }

  @media (max-width: 1099px) {
    :root {
      --header-height: 5rem;
    }

    .atlas-header__bar {
      grid-template-columns: 1fr auto 1fr;
    }

    .atlas-header__nav {
      display: none;
    }

    .atlas-header__menu-button {
      display: block;
    }

    .atlas-header__brand {
      border-inline: 0;
    }

    .atlas-header__tools a > span:first-child {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (max-width: 599px) {
    .atlas-header__announcement {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .atlas-header__announcement span {
      display: none;
    }

    .atlas-header__bar {
      padding-inline: var(--page-margin);
    }

    .atlas-header__tools > a:not([data-cart-open]) {
      display: none;
    }

    .atlas-header__wordmark {
      font-size: clamp(0.85rem, 4vw, 1.1rem);
      letter-spacing: 0.18em;
      text-indent: 0.18em;
    }

    .atlas-header__edition {
      display: none;
    }

    .atlas-header__tools,
    .atlas-header__navigation {
      padding: 0;
    }

    .atlas-header__cart-count {
      min-width: 1.35rem;
      height: 1.35rem;
    }

    .atlas-menu__foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement text",
      "default": "Complimentary worldwide shipping — Every jewel tells a story"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "Transparent over homepage hero",
      "default": true
    },
    {
      "type": "header",
      "content": "Cartographic details"
    },
    {
      "type": "text",
      "id": "coordinate_west",
      "label": "Western coordinate",
      "default": "40.7128° N · 74.0060° W"
    },
    {
      "type": "text",
      "id": "coordinate_east",
      "label": "Eastern coordinate",
      "default": "51.5072° N · 0.1276° W"
    },
    {
      "type": "text",
      "id": "menu_overlay_label",
      "label": "Menu label",
      "default": "Odyssey Jewels · Field Index"
    },
    {
      "type": "text",
      "id": "menu_overlay_footer",
      "label": "Menu footer text",
      "default": "Travel the world — Collect the world"
    }
  ]
}
{% endschema %}
