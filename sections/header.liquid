{% liquid
  if section.settings.announcement != blank
    assign announcement_height = '2.25rem'
  else
    assign announcement_height = '0rem'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    display: block;
    position: sticky;
    top: calc(-1 * {{ announcement_height }});
    z-index: 100;
    width: 100%;
  }

  #shopify-section-{{ section.id }} > * {
    grid-column: unset;
  }
{% endstyle %}

<header class="atlas-header" data-header data-scrolled="false">
  {% if section.settings.announcement != blank %}
    <div class="atlas-header__announcement">
      <p>{{ section.settings.announcement }}</p>
    </div>
  {% endif %}

  <div class="atlas-header__bar">
    <div class="atlas-header__navigation">
      <button
        class="atlas-header__menu-button"
        type="button"
        aria-label="{{ 'general.open_menu' | t }}"
        aria-haspopup="dialog"
        aria-controls="MobileNavigation"
        data-menu-open
      >
        <span></span>
        <span></span>
      </button>

      <nav class="atlas-header__nav" aria-label="Primary navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>
    </div>

    <a class="atlas-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'atlas-header__logo',
            alt: shop.name,
            loading: 'eager',
            widths: '120, 240, 360, 480, 600',
            style: 'width: ' | append: section.settings.logo_width | append: 'px'
        }}
      {% else %}
        <span class="atlas-header__wordmark">{{ shop.name }}</span>
      {% endif %}
    </a>

    <div class="atlas-header__tools">
      <a href="{{ routes.search_url }}" aria-label="Search">
        <span>Search</span>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="Account">
          <span>Account</span>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items" data-cart-open>
        <span>Cart</span>
        <span class="atlas-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<dialog class="atlas-menu" id="MobileNavigation" aria-labelledby="MobileNavigationTitle" data-mobile-menu>
  <div class="atlas-menu__frame">
    <div class="atlas-menu__head">
      <p id="MobileNavigationTitle">{{ section.settings.menu_overlay_label }}</p>
      <button type="button" aria-label="{{ 'general.close_menu' | t }}" data-menu-close>
        <span></span>
        <span></span>
      </button>
    </div>

    <nav class="atlas-menu__nav" aria-label="Mobile navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
          <strong>{{ link.title }}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      {% endfor %}
    </nav>

    <div class="atlas-menu__foot">
      <p>{{ section.settings.menu_overlay_footer }}</p>
      <a href="{{ routes.search_url }}">{{ 'search.title' | t }}</a>
    </div>
  </div>
</dialog>

{% stylesheet %}
  :root {
    --header-height: 5.5rem;
  }

  .atlas-header {
    position: relative;
    width: 100%;
    color: var(--color-foreground);
  }

  .atlas-header__announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    padding-inline: var(--page-inline);
    color: var(--color-contrast);
    background: var(--color-navy);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .atlas-header__announcement p {
    margin: 0;
    text-align: center;
  }

  .atlas-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: var(--header-height);
    padding-inline: var(--page-inline);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
    transition: box-shadow var(--duration) var(--ease);
  }

  .atlas-header[data-scrolled="true"] .atlas-header__bar {
    box-shadow: 0 1rem 2.5rem -2rem var(--color-navy);
  }

  .atlas-header__navigation,
  .atlas-header__tools {
    display: flex;
    align-items: center;
  }

  .atlas-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .atlas-header__nav a,
  .atlas-header__tools a {
    text-decoration: none;
    text-transform: uppercase;
  }

  .atlas-header__nav a {
    padding-block: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .atlas-header__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-md);
    color: currentcolor;
    text-align: center;
    text-decoration: none;
  }

  .atlas-header__wordmark {
    font-family: var(--font-heading--family);
    font-size: clamp(1.15rem, 1.5vw, 1.55rem);
    letter-spacing: 0.28em;
    line-height: 1;
    text-indent: 0.28em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .atlas-header__logo {
    height: auto;
    max-width: 100%;
  }

  .atlas-header__tools {
    justify-content: flex-end;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .atlas-header__tools a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .atlas-header__cart-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding-inline: 0.3rem;
    color: var(--color-contrast);
    background: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .atlas-header__menu-button {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.7rem;
    color: currentcolor;
    background: transparent;
    border: 1px solid var(--color-line);
  }

  .atlas-header__menu-button span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentcolor;
  }

  .atlas-header__menu-button span + span {
    width: 65%;
    margin-top: 0.4rem;
  }

  .atlas-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    color: var(--color-contrast);
    background: var(--color-navy);
    border: 0;
  }

  .atlas-menu::backdrop {
    background: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }

  .atlas-menu__frame {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100%;
    padding: var(--space-md) var(--page-margin);
  }

  .atlas-menu__head,
  .atlas-menu__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .atlas-menu__head {
    padding-bottom: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 20%, transparent);
  }

  .atlas-menu__head p,
  .atlas-menu__foot {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .atlas-menu__head button {
    position: relative;
    width: 3rem;
    height: 3rem;
    color: currentcolor;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-contrast) 30%, transparent);
  }

  .atlas-menu__head button span {
    position: absolute;
    top: 50%;
    left: 25%;
    width: 50%;
    height: 1px;
    background: currentcolor;
    transform: rotate(45deg);
  }

  .atlas-menu__head button span:last-child {
    transform: rotate(-45deg);
  }

  .atlas-menu__nav {
    display: grid;
    align-content: center;
    gap: 0.35rem;
    padding-block: var(--space-xl);
  }

  .atlas-menu__nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 14%, transparent);
  }

  .atlas-menu__nav strong {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 400;
  }

  .atlas-menu__foot a {
    color: inherit;
  }

  @media (max-width: 989px) {
    :root {
      --header-height: 4.75rem;
    }

    .atlas-header__nav {
      display: none;
    }

    .atlas-header__menu-button {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
    }

    .atlas-header__tools span:not(.atlas-header__cart-count) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }

  @media (max-width: 549px) {
    .atlas-header__wordmark {
      font-size: 1rem;
      letter-spacing: 0.18em;
      text-indent: 0.18em;
    }

    .atlas-header__tools {
      gap: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement text",
      "default": "Complimentary worldwide shipping — Every jewel tells a story"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Menu overlay"
    },
    {
      "type": "text",
      "id": "menu_overlay_label",
      "label": "Overlay label",
      "default": "Odyssey Jewels"
    },
    {
      "type": "text",
      "id": "menu_overlay_footer",
      "label": "Overlay footer text",
      "default": "Travel the world — Collect the world"
    }
  ]
}
{% endschema %}
