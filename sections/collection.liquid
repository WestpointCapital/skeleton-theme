{% liquid
  assign per_page = section.settings.products_per_page | default: 24
%}

<section class="coll section-spacing">
  {% if section.settings.show_hero and collection.image %}
    <div class="coll__hero full-width">
      {{
        collection.image
        | image_url: width: 2400
        | image_tag:
          class: 'coll__hero-img',
          loading: 'eager',
          widths: '720, 1200, 1800, 2400',
          sizes: '100vw',
          alt: collection.title
      }}
      <div class="coll__hero-overlay">
        <h1 class="coll__hero-title" data-reveal>{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <div class="coll__hero-desc measure" data-reveal style="--reveal-delay:.1s">{{ collection.description }}</div>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="coll__header">
      {% render 'breadcrumbs', collection: collection %}
      <h1 class="coll__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="coll__desc rte measure">{{ collection.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% paginate collection.products by per_page %}
    <div class="coll__body">
      <aside class="coll__sidebar">
        <details class="coll__filter-toggle" open>
          <summary class="coll__filter-trigger">
            {{ 'collections.filters.title' | t }}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="coll__filter-panel">
            {% render 'facets', results: collection %}
          </div>
        </details>
      </aside>

      <div class="coll__main">
        <div class="coll__toolbar">
          <p class="coll__count meta-label">
            {{ 'collections.products_count' | t: count: collection.products_count }}
          </p>
          <div class="coll__sort field">
            <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
            <select
              id="SortBy-{{ section.id }}"
              class="coll__sort-select field__input"
              onchange="if(this.value){var u=new URL(window.location);u.searchParams.set('sort_by',this.value);window.location=u}"
            >
              {% for option in collection.sort_options %}
                <option
                  value="{{ option.value }}"
                  {% if collection.sort_by == option.value %}selected{% endif %}
                >
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>

        {% if collection.products.size > 0 %}
          <div class="product-grid coll__grid">
            {% for product in collection.products %}
              {% if forloop.index <= 4 %}
                {% assign card_lazy = false %}
              {% else %}
                {% assign card_lazy = true %}
              {% endif %}
              {% render 'product-card',
                product: product,
                index: forloop.index,
                lazy: card_lazy
              %}
            {% endfor %}
          </div>
        {% else %}
          <div class="coll__empty">
            <p>{{ 'collections.empty' | t }}</p>
            <a class="button button--ghost" href="{{ routes.all_products_collection_url }}">
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>
        {% endif %}

        {% render 'pagination', paginate: paginate %}
      </div>
    </div>
  {% endpaginate %}
</section>

{% stylesheet %}
  .coll__hero {
    position: relative;
    aspect-ratio: 3 / 1;
    overflow: hidden;
    margin-bottom: var(--space-xl);
  }
  @media (max-width: 749px) {
    .coll__hero { aspect-ratio: 4 / 3; }
  }
  .coll__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .coll__hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-lg);
    color: var(--color-contrast);
    background: color-mix(in srgb, var(--color-navy) 48%, transparent);
  }
  .coll__hero-title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    font-weight: 400;
  }
  .coll__hero-desc {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  .coll__header {
    margin-bottom: var(--space-lg);
  }
  .coll__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  .coll__desc { color: var(--color-foreground-50); }

  .coll__body {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  @media (min-width: 990px) {
    .coll__body {
      grid-template-columns: 15rem 1fr;
    }
  }

  .coll__filter-toggle {
    border: 0;
  }
  .coll__filter-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    cursor: pointer;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .coll__filter-trigger::-webkit-details-marker { display: none; }
  .coll__filter-trigger svg {
    transition: transform var(--duration) var(--ease);
  }
  .coll__filter-toggle[open] .coll__filter-trigger svg {
    transform: rotate(180deg);
  }
  .coll__filter-panel { margin-top: var(--space-md); }

  @media (max-width: 989px) {
    .coll__filter-toggle:not([open]) .coll__filter-panel {
      display: none;
    }
  }
  @media (min-width: 990px) {
    .coll__sidebar {
      position: sticky;
      top: calc(var(--header-height, 4.5rem) + 1.5rem);
      align-self: start;
    }
    .coll__filter-trigger svg { display: none; }
  }

  .coll__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }
  .coll__count { margin: 0; }
  .coll__sort-select {
    min-width: 10rem;
    padding: 0.6rem 0.85rem;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .coll__empty {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    padding: var(--space-xl) 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show collection hero image",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    }
  ]
}
{% endschema %}
