{% liquid
  assign limit = section.settings.products_to_show | default: 8
%}

<product-recommendations
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  {% if recommendations.performed and recommendations.products.size > 0 %}
    <section class="recs section-spacing" data-rail-scope>
      {% assign recs_heading = section.settings.heading %}
      {% if recs_heading == blank %}
        {% assign recs_heading = 'products.recommendations' | t %}
      {% endif %}
      {% render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: recs_heading
      %}

      <div class="recs__viewport">
        <div class="recs__rail" data-rail>
          {% for product in recommendations.products limit: limit %}
            {% render 'product-card', product: product, index: forloop.index, class: 'recs__card' %}
          {% endfor %}
        </div>
      </div>

      <div class="recs__controls">
        <button class="recs__arrow" type="button" data-rail-prev aria-label="{{ 'general.pagination.previous' | t }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <path d="M20 12H5m0 0 5.5-5.5M5 12l5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="recs__track">
          <div class="recs__progress" data-rail-progress></div>
        </div>
        <button class="recs__arrow" type="button" data-rail-next aria-label="{{ 'general.pagination.next' | t }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </section>
  {% endif %}
</product-recommendations>

{% stylesheet %}
  .recs__viewport {
    overflow: hidden;
  }
  .recs__rail {
    display: flex;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .recs__rail::-webkit-scrollbar { display: none; }
  .recs__card {
    flex: 0 0 clamp(14rem, 22vw, 19rem);
    scroll-snap-align: start;
  }
  .recs__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-lg);
  }
  .recs__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease);
  }
  .recs__arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .recs__track {
    flex: 1;
    height: 1px;
    background: var(--color-line);
    overflow: hidden;
  }
  .recs__progress {
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0.08);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Also treasure"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the region"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    }
  ]
}
{% endschema %}
