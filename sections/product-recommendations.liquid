<section
  class="oj-recommendations"
  id="Recommendations-{{ section.id }}"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <header>
      <p>{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </header>
    <div class="oj-recommendations__grid">
      {% for product in recommendations.products %}
        {% render 'product-card', product: product, show_vendor: section.settings.show_vendor, lazy: true %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% javascript %}
  document.querySelectorAll('[data-recommendations]').forEach((root) => {
    if (root.innerHTML.trim() || root.dataset.loading === 'true') return;
    root.dataset.loading = 'true';
    fetch(root.dataset.url)
      .then((response) => response.text())
      .then((text) => {
        const html = new DOMParser().parseFromString(text, 'text/html');
        const replacement = html.querySelector(`#${root.id}`);
        if (replacement) root.innerHTML = replacement.innerHTML;
      })
      .catch(() => {
        root.hidden = true;
      });
  });
{% endjavascript %}

{% stylesheet %}
  .oj-recommendations {
    padding: clamp(3rem, 8vw, 8rem) clamp(1rem, 5vw, 5rem);
    color: var(--color-foreground);
  }

  .oj-recommendations header {
    margin-bottom: clamp(2rem, 5vw, 5rem);
  }

  .oj-recommendations header p {
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .oj-recommendations h2 {
    margin: 0.3rem 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.9;
  }

  .oj-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  @media (max-width: 900px) {
    .oj-recommendations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .oj-recommendations__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Adjacent coordinates" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Continue the journey" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show maker", "default": true },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
