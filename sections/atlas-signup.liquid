<section id="AtlasSignup-{{ section.id }}" class="atlas-signup">
  <div class="atlas-signup__inner">
    <p class="atlas-signup__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="atlas-signup__text">{{ section.settings.text }}</div>

    {% form 'customer', class: 'atlas-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="AtlasEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
      <div class="atlas-signup__field">
        <input
          id="AtlasEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}"
          autocomplete="email"
          autocapitalize="off"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="AtlasFormStatus-{{ section.id }}"{% endif %}
        >
        <button type="submit">{{ section.settings.button_label }} <span aria-hidden="true">→</span></button>
      </div>
      {% if form.posted_successfully? %}
        <p id="AtlasFormStatus-{{ section.id }}" class="atlas-signup__status" tabindex="-1">{{ section.settings.success_message }}</p>
      {% elsif form.errors %}
        <div id="AtlasFormStatus-{{ section.id }}" class="atlas-signup__status" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}

    {% if section.settings.note != blank %}
      <p class="atlas-signup__note">{{ section.settings.note }}</p>
    {% endif %}
  </div>
</section>

{% style %}
  #AtlasSignup-{{ section.id }} {
    display: grid;
    place-items: center;
    padding: var(--section-spacing) var(--page-margin);
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-accent-soft) 72%, var(--color-background));
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__inner {
    width: min(100%, 42rem);
    text-align: center;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__eyebrow {
    margin: 0 0 1.25rem;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #AtlasSignup-{{ section.id }} h2 {
    max-width: 14ch;
    margin: 0 auto;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.04em;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__text {
    max-width: 34rem;
    margin: 1.35rem auto 0;
    line-height: 1.7;
    opacity: .8;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__form {
    max-width: 34rem;
    margin: clamp(2.25rem, 4vw, 3.5rem) auto 0;
    text-align: left;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__form > label {
    display: block;
    margin-bottom: .65rem;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field {
    display: grid;
    grid-template-columns: 1fr auto;
    border-bottom: 1px solid var(--color-foreground);
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field input {
    min-width: 0;
    padding: 1rem 0;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 0;
    font: inherit;
    font-size: 1rem;
    outline-offset: .2rem;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field input::placeholder {
    color: color-mix(in srgb, var(--color-foreground) 50%, transparent);
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field button {
    padding: 1rem 0 1rem 1.5rem;
    color: inherit;
    background: transparent;
    border: 0;
    font-size: .65rem;
    letter-spacing: .11em;
    text-transform: uppercase;
    cursor: pointer;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__status {
    margin: 1rem 0 0;
    font-size: .82rem;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__note {
    margin: 2rem 0 0;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .65;
  }
  @media (max-width: 599px) {
    #AtlasSignup-{{ section.id }} .atlas-signup__field {
      grid-template-columns: 1fr;
    }
    #AtlasSignup-{{ section.id }} .atlas-signup__field button {
      padding-left: 0;
      text-align: left;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas signup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A world of jewellery, in your inbox." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to see new pieces, meet the makers behind them and hear where we’re travelling next.</p>" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Your email address" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "collector@example.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You’re on the list. We’ll be in touch soon." },
    { "type": "text", "id": "note", "label": "Footer note", "default": "New jewellery and stories, sent occasionally." }
  ],
  "presets": [{ "name": "Atlas signup" }]
}
{% endschema %}
