<section id="AtlasSignup-{{ section.id }}" class="atlas-signup">
  <svg class="atlas-signup__route" viewBox="0 0 1440 520" fill="none" aria-hidden="true">
    <path d="M-40 443C182 390 206 103 449 118c195 12 171 252 363 249 223-3 244-274 668-251"/>
    <path d="M-25 486C199 428 252 171 459 167c170-3 173 232 356 239 231 10 297-232 684-235"/>
    <circle cx="449" cy="118" r="8"/>
    <circle cx="812" cy="367" r="8"/>
  </svg>

  <div class="atlas-signup__inner">
    <p class="atlas-signup__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="atlas-signup__text">{{ section.settings.text }}</div>

    {% form 'customer', class: 'atlas-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="AtlasEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
      <div class="atlas-signup__field">
        <input
          id="AtlasEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}"
          autocomplete="email"
          autocapitalize="off"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="AtlasFormStatus-{{ section.id }}"{% endif %}
        >
        <button type="submit">{{ section.settings.button_label }} <span aria-hidden="true">→</span></button>
      </div>
      {% if form.posted_successfully? %}
        <p id="AtlasFormStatus-{{ section.id }}" class="atlas-signup__status" tabindex="-1">{{ section.settings.success_message }}</p>
      {% elsif form.errors %}
        <div id="AtlasFormStatus-{{ section.id }}" class="atlas-signup__status" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}

    <div class="atlas-signup__footer">
      <span>{{ section.settings.coordinate }}</span>
      <span>{{ section.settings.note }}</span>
    </div>
  </div>
</section>

{% style %}
  #AtlasSignup-{{ section.id }} {
    position: relative;
    min-height: 42rem;
    display: grid;
    place-items: center;
    padding: var(--section-spacing) var(--page-margin);
    color: var(--color-foreground);
    background: var(--color-accent-soft);
    overflow: hidden;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__route path {
    stroke: color-mix(in srgb, var(--color-foreground) 25%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 9;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__route circle {
    fill: var(--color-accent-soft);
    stroke: var(--color-foreground);
    stroke-width: 1;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 62rem);
    padding: clamp(2rem, 6vw, 5rem);
    background: color-mix(in srgb, var(--color-background) 92%, transparent);
    backdrop-filter: blur(12px);
    text-align: center;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__eyebrow {
    margin: 0 0 1.25rem;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #AtlasSignup-{{ section.id }} h2 {
    max-width: 12ch;
    margin: 0 auto;
    font-size: clamp(3rem, 6.5vw, 7.2rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.05em;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__text {
    max-width: 38rem;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__form {
    max-width: 40rem;
    margin: clamp(2.5rem, 5vw, 4.5rem) auto 0;
    text-align: left;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__form > label {
    display: block;
    margin-bottom: .65rem;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field {
    display: grid;
    grid-template-columns: 1fr auto;
    border-bottom: 1px solid var(--color-foreground);
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field input {
    min-width: 0;
    padding: 1rem 0;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 0;
    font: inherit;
    font-size: 1rem;
    outline-offset: .2rem;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field input::placeholder {
    color: color-mix(in srgb, var(--color-foreground) 50%, transparent);
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__field button {
    padding: 1rem 0 1rem 1.5rem;
    color: inherit;
    background: transparent;
    border: 0;
    font-size: .65rem;
    letter-spacing: .11em;
    text-transform: uppercase;
    cursor: pointer;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__status {
    margin: 1rem 0 0;
    font-size: .82rem;
  }
  #AtlasSignup-{{ section.id }} .atlas-signup__footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: .58rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  @media (max-width: 599px) {
    #AtlasSignup-{{ section.id }} {
      padding-inline: 0;
    }
    #AtlasSignup-{{ section.id }} .atlas-signup__field {
      grid-template-columns: 1fr;
    }
    #AtlasSignup-{{ section.id }} .atlas-signup__field button {
      padding-left: 0;
      text-align: left;
    }
    #AtlasSignup-{{ section.id }} .atlas-signup__footer {
      align-items: center;
      flex-direction: column;
      gap: .5rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas signup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the next route" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Receive coordinates before release." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Private field dispatches, first access to singular objects and invitations to new regional chapters.</p>" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Your email address" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "collector@example.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the atlas" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Your coordinates are recorded. Welcome to the atlas." },
    { "type": "text", "id": "coordinate", "label": "Footer coordinate", "default": "59° 54′ N · 10° 45′ E" },
    { "type": "text", "id": "note", "label": "Footer note", "default": "No noise. Only meaningful dispatches." }
  ],
  "presets": [{ "name": "Atlas signup" }]
}
{% endschema %}
