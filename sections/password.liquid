<section class="password-landing full-width{% if section.settings.background_image != blank %} password-landing--image{% endif %}">
  {% if section.settings.background_image != blank %}
    {{
      section.settings.background_image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        class: 'password-landing__image',
        alt: section.settings.background_image.alt
    }}
  {% endif %}
  <div class="password-landing__scrim" aria-hidden="true"></div>
  <div class="password-landing__coordinates meta-label" aria-hidden="true">
    <span>34.0000° S</span>
    <span>151.0000° E</span>
  </div>

  <div class="password-landing__content">
    <div class="password-landing__brand" data-reveal>
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            widths: '200, 300, 450, 600',
            sizes: 'min(60vw, 300px)',
            loading: 'eager',
            class: 'password-landing__logo',
            alt: shop.name
        }}
      {% else %}
        <span class="password-landing__monogram" aria-hidden="true">OJ</span>
        <span class="password-landing__name">{{ shop.name | escape }}</span>
      {% endif %}
    </div>

    <div class="password-landing__copy" data-reveal>
      <p class="eyebrow eyebrow--rule">{{ 'password.eyebrow' | t }}</p>
      <h1>{{ 'password.title' | t }}</h1>
      {% if shop.password_message != blank %}
        <div class="password-landing__message">{{ shop.password_message }}</div>
      {% else %}
        <p class="password-landing__message">{{ 'password.message' | t }}</p>
      {% endif %}
      <p class="password-landing__signature">{{ 'password.signature' | t }}</p>
    </div>

    <details class="password-access" data-reveal>
      <summary>{{ 'password.open_form' | t }}</summary>
      <div class="password-access__panel">
        {% form 'storefront_password', class: 'password-form' %}
          {% if form.errors %}
            <div class="password-form__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <label for="password-input">{{ 'password.password' | t }}</label>
          <div class="password-form__field">
            <input
              type="password"
              name="password"
              id="password-input"
              autocomplete="current-password"
              required
            >
            <button class="button button--on-dark" type="submit">{{ 'password.enter' | t }}</button>
          </div>
        {% endform %}
      </div>
    </details>
  </div>

  <p class="password-landing__footer meta-label">{{ 'password.footer' | t }}</p>
</section>

{% stylesheet %}
  .password-landing {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(5rem, 9vw, 8rem) var(--page-margin) var(--space-xl);
    overflow: hidden;
    color: var(--color-contrast);
    background:
      radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 35%),
      var(--color-navy);
  }

  .password-landing__image,
  .password-landing__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .password-landing__image {
    object-fit: cover;
  }

  .password-landing__scrim {
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-navy) 92%, transparent), color-mix(in srgb, var(--color-navy) 54%, transparent));
  }

  .password-landing:not(.password-landing--image) .password-landing__scrim {
    opacity: 0;
  }

  .password-landing__coordinates {
    position: absolute;
    top: var(--space-lg);
    right: var(--page-margin);
    display: flex;
    gap: var(--space-md);
    z-index: 1;
  }

  .password-landing__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(12rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: center;
    width: min(100%, 72rem);
  }

  .password-landing__brand {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    padding: var(--space-xl);
    border: 1px solid color-mix(in srgb, var(--color-contrast) 25%, transparent);
    aspect-ratio: 1;
  }

  .password-landing__logo {
    width: min(100%, 18rem);
    align-self: center;
  }

  .password-landing__monogram {
    align-self: end;
    font-family: var(--font-heading--family);
    font-size: var(--text-hero);
    font-style: italic;
    line-height: 0.8;
  }

  .password-landing__name {
    align-self: start;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .password-landing .eyebrow {
    color: var(--color-accent-soft);
  }

  .password-landing h1 {
    max-width: 12ch;
    margin-top: var(--space-md);
    font-size: var(--text-4xl);
  }

  .password-landing__message {
    max-width: 42ch;
    margin-top: var(--space-md);
    color: color-mix(in srgb, var(--color-contrast) 78%, transparent);
    font-size: var(--text-lg);
  }

  .password-landing__signature {
    margin-top: var(--space-lg);
    color: var(--color-accent-soft);
    font-family: var(--font-heading--family);
    font-size: var(--text-xl);
    font-style: italic;
  }

  .password-access {
    grid-column: 2;
    margin-top: calc(var(--space-lg) * -1);
  }

  .password-access summary {
    display: inline-block;
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    border-bottom: 1px solid currentcolor;
  }

  .password-access summary::marker {
    content: "";
  }

  .password-access__panel {
    margin-top: var(--space-md);
  }

  .password-form label {
    display: block;
    margin-bottom: var(--space-xs);
    font-size: var(--text-sm);
  }

  .password-form__field {
    display: flex;
    max-width: 34rem;
  }

  .password-form input {
    min-width: 0;
    flex: 1;
    padding: 0.9rem 1rem;
    color: var(--color-foreground);
    background: var(--color-background);
    border: 1px solid var(--color-contrast);
    border-radius: var(--style-border-radius-inputs) 0 0 var(--style-border-radius-inputs);
  }

  .password-form .button {
    border-radius: 0 var(--style-border-radius-inputs) var(--style-border-radius-inputs) 0;
  }

  .password-form__errors {
    max-width: 34rem;
    margin-bottom: var(--space-md);
    padding: var(--space-sm);
    border-left: 2px solid var(--color-accent);
  }

  .password-landing__footer {
    position: absolute;
    right: var(--page-margin);
    bottom: var(--space-lg);
    z-index: 1;
  }

  @media (max-width: 749px) {
    .password-landing {
      align-items: start;
    }

    .password-landing__coordinates {
      left: var(--page-margin);
      right: auto;
    }

    .password-landing__content {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .password-landing__brand {
      width: min(12rem, 50vw);
      padding: var(--space-md);
    }

    .password-access {
      grid-column: 1;
      margin-top: 0;
    }

    .password-form__field {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .password-form input,
    .password-form .button {
      border-radius: var(--style-border-radius-inputs);
    }

    .password-landing__footer {
      position: relative;
      right: auto;
      bottom: auto;
      z-index: 1;
      margin-top: var(--space-xl);
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    }
  ]
}
{% endschema %}
