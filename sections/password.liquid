{% liquid
  assign poster = section.settings.poster_url
  if section.settings.poster_image != blank
    assign poster = section.settings.poster_image | image_url: width: 2400
  endif

  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
%}

<section
  class="password-gate full-width on-dark"
  {% if has_video %}data-video-section{% endif %}
>
  <div class="password-gate__media">
    {% if has_video %}
      {% render 'responsive-bg-video',
        classes: 'password-gate__bg',
        desktop_video: section.settings.video,
        desktop_url: section.settings.video_url,
        mobile_video: section.settings.video_mobile,
        mobile_url: section.settings.video_mobile_url,
        poster: poster,
        autoplay: true
      %}
    {% elsif poster != blank %}
      <img class="password-gate__bg" src="{{ poster }}" alt="" loading="eager" width="2400" height="1350">
    {% endif %}
    <div class="password-gate__overlay"></div>
  </div>

  <div class="password-gate__content">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="password-gate__title">
      {{ section.settings.heading }}
      {% if section.settings.heading_italic != blank %}
        <em>{{ section.settings.heading_italic }}</em>
      {% endif %}
    </h1>
    <p class="password-gate__text">
      {% if shop.password_message != blank %}
        {{ shop.password_message }}
      {% else %}
        {{ section.settings.subtext }}
      {% endif %}
    </p>

    {% form 'storefront_password', class: 'password-gate__form' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="Password-{{ section.id }}">{{ 'password.password' | t }}</label>
        <input
          class="field__input"
          type="password"
          name="password"
          id="Password-{{ section.id }}"
          autocomplete="current-password"
        >
      </div>
      <button class="button button--on-dark" type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}

    {% if section.settings.show_newsletter %}
      {% form 'customer', class: 'password-gate__newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter, password">
        <p class="eyebrow">{{ 'password.newsletter' | t }}</p>
        <div class="password-gate__newsletter-row">
          <label class="visually-hidden" for="PasswordEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input
            id="PasswordEmail-{{ section.id }}"
            class="field__input"
            type="email"
            name="contact[email]"
            placeholder="{{ 'newsletter.placeholder' | t }}"
            required
          >
          <button class="button button--ghost" type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
      {% endform %}
    {% endif %}
  </div>

  {% if has_video and section.settings.show_controls %}
    {% render 'media-controls', autoplay: true %}
  {% endif %}
</section>

{% stylesheet %}
  .password-gate {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-contrast);
  }
  .password-gate__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .password-gate__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .password-gate__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-navy) 68%, transparent);
  }
  .password-gate__content {
    width: min(32rem, 100%);
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl) var(--page-inline);
    text-align: center;
    justify-items: center;
  }
  .password-gate__title {
    font-size: var(--text-4xl);
    font-weight: 400;
  }
  .password-gate__title em {
    display: block;
  }
  .password-gate__text {
    max-width: 36ch;
    color: color-mix(in srgb, var(--color-contrast) 84%, transparent);
  }
  .password-gate__form,
  .password-gate__newsletter {
    width: 100%;
    display: grid;
    gap: var(--space-sm);
  }
  .password-gate__form .field,
  .password-gate__form .button {
    width: 100%;
  }
  .password-gate__newsletter-row {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 750px) {
    .password-gate__newsletter-row {
      grid-template-columns: 1fr auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Desktop video URL",
      "default": "https://cdn.media.amplience.net/v/pandora/2026Q2D_platform_summer_awa_be_essence_motion_film06_10s_16x9_Gemini/mp4_720p"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video"
    },
    {
      "type": "text",
      "id": "video_mobile_url",
      "label": "Mobile video URL"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Poster image URL",
      "default": "https://images.unsplash.com/photo-1505142468610-359e7d316be0?auto=format&fit=crop&w=2400&q=80"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The odyssey begins soon"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Enter the password to preview the first drop."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    }
  ]
}
{% endschema %}
