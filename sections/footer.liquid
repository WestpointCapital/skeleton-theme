<footer class="atlas-footer full-width">
  <div class="atlas-footer__coordinates" aria-hidden="true">
    <span>ODJ · {{ 'now' | date: '%Y' }}</span>
    <span>{{ section.settings.coordinates }}</span>
    <span>Archive · 07</span>
  </div>

  <div class="atlas-footer__field">
    <div class="atlas-footer__introduction">
      {% if section.settings.tagline != blank %}
        <p class="atlas-footer__eyebrow">{{ section.settings.tagline }}</p>
      {% endif %}
      <p class="atlas-footer__wordmark">{{ shop.name }}</p>
      {% if section.settings.blurb != blank %}
        <p class="atlas-footer__blurb">{{ section.settings.blurb }}</p>
      {% endif %}
    </div>

    {% if section.settings.show_newsletter %}
      <div class="atlas-footer__newsletter">
        <span class="atlas-footer__index">N · 01</span>
        <h2>{{ section.settings.newsletter_title }}</h2>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterEmail-{{ section.id }}">{{ 'general.email' | t }}</label>
          <div class="atlas-footer__field-control">
            <input
              id="FooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              autocomplete="email"
              required
            >
            <button type="submit">{{ section.settings.newsletter_button | default: 'Join the field notes' }} <span aria-hidden="true">↗</span></button>
          </div>
          {% if form.errors %}
            <div class="atlas-footer__form-note" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          {% if form.posted_successfully? %}
            <p class="atlas-footer__form-note" role="status">{{ 'general.newsletter_success' | t }}</p>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    <nav class="atlas-footer__navigation" aria-label="Footer navigation">
      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          <div class="atlas-footer__column" {{ block.shopify_attributes }}>
            <p>
              <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {{ block.settings.title }}
            </p>
            <ul>
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }} <span aria-hidden="true">↗</span></a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </nav>
  </div>

  <div class="atlas-footer__base">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <a href="#MainContent">Return to origin ↑</a>
    {% if section.settings.show_payment_icons %}
      <div class="atlas-footer__payments" aria-label="Accepted payment methods">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .atlas-footer {
    position: relative;
    color: var(--color-contrast);
    background: var(--color-navy);
    overflow: hidden;
  }

  .atlas-footer::before,
  .atlas-footer::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .atlas-footer::before {
    top: 0;
    left: 25%;
    width: 1px;
    height: 100%;
    background: color-mix(in srgb, var(--color-accent-soft) 13%, transparent);
    box-shadow:
      25vw 0 color-mix(in srgb, var(--color-accent-soft) 13%, transparent),
      50vw 0 color-mix(in srgb, var(--color-accent-soft) 13%, transparent);
  }

  .atlas-footer::after {
    right: -16vw;
    bottom: -30vw;
    width: 52vw;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-accent-soft) 18%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 0 8vw color-mix(in srgb, var(--color-accent-soft) 4%, transparent),
      0 0 0 16vw color-mix(in srgb, var(--color-accent-soft) 3%, transparent);
  }

  .atlas-footer__coordinates,
  .atlas-footer__field,
  .atlas-footer__base {
    position: relative;
    z-index: 1;
    padding-inline: var(--page-inline);
  }

  .atlas-footer__coordinates {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-md);
    padding-block: 0.85rem;
    color: color-mix(in srgb, var(--color-contrast) 55%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 18%, transparent);
    font-size: 0.5625rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .atlas-footer__coordinates span:last-child {
    text-align: right;
  }

  .atlas-footer__field {
    display: grid;
    grid-template-columns: minmax(18rem, 1.1fr) minmax(20rem, 0.9fr);
    grid-template-areas:
      "introduction newsletter"
      "introduction navigation";
    gap: var(--space-xl) var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  .atlas-footer__introduction {
    grid-area: introduction;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-right: var(--space-lg);
  }

  .atlas-footer__eyebrow,
  .atlas-footer__index,
  .atlas-footer__column > p {
    color: var(--color-accent-soft);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .atlas-footer__eyebrow::before {
    content: "⌖";
    margin-right: 0.75rem;
  }

  .atlas-footer__wordmark {
    max-width: 8ch;
    margin-block: auto var(--space-lg);
    font-family: var(--font-heading--family);
    font-size: clamp(4rem, 9vw, 10rem);
    font-style: italic;
    letter-spacing: -0.06em;
    line-height: 0.72;
    text-transform: uppercase;
  }

  .atlas-footer__blurb {
    max-width: 42ch;
    color: color-mix(in srgb, var(--color-contrast) 72%, transparent);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.75;
  }

  .atlas-footer__newsletter {
    grid-area: newsletter;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 18%, transparent);
  }

  .atlas-footer__newsletter h2 {
    margin-block: var(--space-xs) var(--space-md);
    font-size: var(--text-2xl);
    font-style: italic;
    font-weight: var(--font-heading--weight);
  }

  .atlas-footer__newsletter label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .atlas-footer__field-control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 50%, transparent);
  }

  .atlas-footer__field-control:focus-within {
    border-color: var(--color-accent-soft);
  }

  .atlas-footer__field-control input,
  .atlas-footer__field-control button {
    color: var(--color-contrast);
    background: transparent;
    border: 0;
  }

  .atlas-footer__field-control input {
    min-width: 0;
    padding: 1rem 0;
    outline: 0;
  }

  .atlas-footer__field-control input::placeholder {
    color: color-mix(in srgb, var(--color-contrast) 48%, transparent);
  }

  .atlas-footer__field-control button {
    padding: 1rem 0 1rem var(--space-sm);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .atlas-footer__field-control button span {
    color: var(--color-accent-soft);
    margin-left: 0.5rem;
  }

  .atlas-footer__form-note {
    margin-top: var(--space-xs);
    color: var(--color-accent-soft);
    font-size: var(--text-sm);
  }

  .atlas-footer__navigation {
    grid-area: navigation;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .atlas-footer__column > p {
    display: flex;
    gap: 0.75rem;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid color-mix(in srgb, var(--color-contrast) 18%, transparent);
  }

  .atlas-footer__column > p span {
    color: color-mix(in srgb, var(--color-contrast) 45%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .atlas-footer__column ul {
    display: grid;
    gap: 0.7rem;
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
  }

  .atlas-footer__column a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: color-mix(in srgb, var(--color-contrast) 76%, transparent);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .atlas-footer__column a:hover {
    color: var(--color-contrast);
  }

  .atlas-footer__column a span {
    color: var(--color-accent-soft);
  }

  .atlas-footer__base {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
    min-height: 5rem;
    color: color-mix(in srgb, var(--color-contrast) 55%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--color-contrast) 18%, transparent);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .atlas-footer__base > a {
    color: var(--color-contrast);
  }

  .atlas-footer__payments {
    display: flex;
    justify-content: flex-end;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .atlas-footer__payments svg {
    width: 2rem;
  }

  @media (max-width: 989px) {
    .atlas-footer__field {
      grid-template-columns: 1fr;
      grid-template-areas:
        "introduction"
        "newsletter"
        "navigation";
    }

    .atlas-footer__wordmark {
      margin-block: var(--space-xl) var(--space-lg);
      font-size: clamp(4rem, 18vw, 8rem);
    }

    .atlas-footer__introduction {
      padding-right: 0;
    }
  }

  @media (max-width: 599px) {
    .atlas-footer__coordinates {
      grid-template-columns: 1fr auto;
    }

    .atlas-footer__coordinates span:nth-child(2) {
      display: none;
    }

    .atlas-footer__field {
      gap: var(--space-xl);
      padding-block: var(--space-xl);
    }

    .atlas-footer__navigation,
    .atlas-footer__field-control,
    .atlas-footer__base {
      grid-template-columns: 1fr;
    }

    .atlas-footer__field-control button {
      justify-self: start;
      padding-left: 0;
    }

    .atlas-footer__base {
      align-items: start;
      padding-block: var(--space-md);
    }

    .atlas-footer__payments {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Jewellery from around the world"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand statement",
      "default": "Jewellery chosen from independent makers around the world. Each piece is selected for its beauty, craftsmanship and connection to place."
    },
    {
      "type": "header",
      "content": "Field notes"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "New pieces and stories, from time to time"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button",
      "default": "Join the field notes"
    },
    {
      "type": "text",
      "id": "coordinates",
      "label": "Coordinates line",
      "default": "40.7128° N · 74.0060° W"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
