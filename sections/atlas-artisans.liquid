<section id="AtlasArtisans-{{ section.id }}" class="atlas-artisans">
  <header class="atlas-artisans__header">
    <p>{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div>{{ section.settings.intro }}</div>
  </header>

  <div class="atlas-artisans__layout">
    <figure class="atlas-artisans__place">
      <div class="atlas-artisans__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700, 1000, 1400, 1800', sizes: '(min-width: 900px) 60vw, 100vw', alt: section.settings.image_alt }}
        {% elsif section.settings.fallback_image_url != blank %}
          <img src="{{ section.settings.fallback_image_url }}" alt="{{ section.settings.image_alt | escape }}" width="1500" height="1100" loading="lazy">
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <figcaption>
        <span>{{ section.settings.coordinates }}</span>
        <p>{{ section.settings.caption }}</p>
      </figcaption>
    </figure>

    <div class="atlas-artisans__people">
      {% for block in section.blocks %}
        <article class="atlas-person" {{ block.shopify_attributes }}>
          <div class="atlas-person__head">
            <span>{{ forloop.index | prepend: '0' }}</span>
            <span>{{ block.settings.place }}</span>
          </div>
          <h3>{{ block.settings.name }}</h3>
          <p class="atlas-person__practice">{{ block.settings.practice }}</p>
          <div class="atlas-person__text">{{ block.settings.text }}</div>
          {% if block.settings.link_label != blank %}
            <a href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.link_label }} <span aria-hidden="true">↗</span></a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #AtlasArtisans-{{ section.id }} {
    padding: var(--section-spacing) max(var(--page-margin), calc((100vw - var(--page-width)) / 2));
    color: var(--color-foreground);
    background: var(--color-background);
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__header {
    display: grid;
    grid-template-columns: .4fr 1fr .75fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__header > p {
    margin: .55rem 0 0;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__header h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.5rem, 4.8vw, 5rem);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.04em;
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__header > div {
    line-height: 1.7;
    opacity: .74;
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .55fr);
    gap: clamp(2rem, 5vw, 6rem);
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__place {
    margin: 0;
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-navy);
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__media > :is(img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #AtlasArtisans-{{ section.id }} figcaption {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1rem;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasArtisans-{{ section.id }} figcaption p {
    max-width: 26rem;
    margin: 0;
    text-align: right;
  }
  #AtlasArtisans-{{ section.id }} .atlas-artisans__people {
    border-top: 1px solid var(--color-line);
  }
  #AtlasArtisans-{{ section.id }} .atlas-person {
    padding: 1.35rem 0 1.75rem;
    border-bottom: 1px solid var(--color-line);
  }
  #AtlasArtisans-{{ section.id }} .atlas-person__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-accent);
    font-size: .6rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasArtisans-{{ section.id }} .atlas-person h3 {
    margin: 1.15rem 0 .35rem;
    font-size: clamp(1.8rem, 2.8vw, 2.8rem);
    font-weight: 400;
    line-height: .98;
  }
  #AtlasArtisans-{{ section.id }} .atlas-person__practice {
    margin: 0 0 1.25rem;
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasArtisans-{{ section.id }} .atlas-person__text {
    font-size: .88rem;
    line-height: 1.65;
    opacity: .72;
  }
  #AtlasArtisans-{{ section.id }} .atlas-person a {
    display: inline-block;
    margin-top: 1.25rem;
    color: inherit;
    font-size: .62rem;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }
  @media (max-width: 899px) {
    #AtlasArtisans-{{ section.id }} .atlas-artisans__header,
    #AtlasArtisans-{{ section.id }} .atlas-artisans__layout {
      grid-template-columns: 1fr;
    }
    #AtlasArtisans-{{ section.id }} .atlas-artisans__header {
      gap: 1.5rem;
    }
  }
  @media (max-width: 599px) {
    #AtlasArtisans-{{ section.id }} figcaption {
      flex-direction: column;
      gap: .5rem;
    }
    #AtlasArtisans-{{ section.id }} figcaption p {
      text-align: left;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas artisans",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet the makers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by people, not production lines." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>We work with independent jewellers and small workshops, building relationships that let us understand how—and why—each piece is made.</p>" },
    { "type": "image_picker", "id": "image", "label": "Shopify image" },
    { "type": "url", "id": "fallback_image_url", "label": "Demo image URL" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Coastal landscape near an artisan workshop" },
    { "type": "text", "id": "coordinates", "label": "Coordinates", "default": "16° 30′ S · 151° 45′ W" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "On the way to the workshop · Society Islands" }
  ],
  "blocks": [
    {
      "type": "artisan",
      "name": "Artisan",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Tehani" },
        { "type": "text", "id": "place", "label": "Place", "default": "Raiatea" },
        { "type": "text", "id": "practice", "label": "Practice", "default": "Pearl setting · 22 years" },
        { "type": "richtext", "id": "text", "label": "Story", "default": "<p>Tehani works with the natural shape of every pearl, creating settings that preserve the character it developed in the lagoon.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Meet the maker" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Atlas artisans", "blocks": [{ "type": "artisan" }, { "type": "artisan" }] }]
}
{% endschema %}
