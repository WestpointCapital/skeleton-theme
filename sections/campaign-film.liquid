{% comment %}
  Campaign film — single cinematic cut with corner copy blocks.
{% endcomment %}

<section class="camp-film full-width">
  <div class="camp-film__frame">
    {% render 'responsive-bg-video',
      classes: 'camp-film__video',
      desktop_url: section.settings.video_url,
      mobile_url: section.settings.video_mobile_url,
      poster: section.settings.poster_url,
      autoplay: section.settings.autoplay,
      lazy: true
    %}
    {% if section.settings.show_controls %}
      {% render 'media-controls' %}
    {% endif %}

    <div class="camp-film__copy field-{{ section.settings.copy_color }}">
      {% if section.settings.label != blank %}
        <p class="camp-label" data-cut-in>{{ section.settings.label }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="camp-film__title" data-cut-in style="--cut-delay: 0.05s">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="camp-film__body rte" data-cut-in style="--cut-delay: 0.1s">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button button--on-dark" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" data-cut-in style="--cut-delay: 0.15s">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .camp-film__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: clamp(16rem, 50vw, 36rem);
    background: var(--field-navy);
    overflow: hidden;
  }
  .camp-film__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .camp-film__copy {
    position: absolute;
    left: var(--page-inline);
    bottom: clamp(1.25rem, 2vw, 2.5rem);
    max-width: min(28rem, calc(100% - 2rem));
    padding: clamp(1rem, 2vw, 1.75rem);
    display: grid;
    gap: var(--space-sm);
    z-index: 2;
  }
  .camp-film__title {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  .camp-film__body {
    font-size: var(--text-sm);
    line-height: 1.45;
    max-width: 36ch;
  }
  .camp-film__copy.field-pearl .camp-label {
    background: var(--field-rose);
    color: var(--color-contrast);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign film",
  "tag": "section",
  "class": "camp-film-section",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://cdn.media.amplience.net/v/pandora/2026Q2D_platform_summer_con_be_ocean_motion_film02_10s_16x9_Gemini/mp4_480p"
    },
    {
      "type": "text",
      "id": "video_mobile_url",
      "label": "Mobile video URL"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Poster URL",
      "default": "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": true
    },
    {
      "type": "select",
      "id": "copy_color",
      "label": "Copy block color",
      "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "rose", "label": "Rose" },
        { "value": "pearl", "label": "Pearl" }
      ],
      "default": "navy"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Film"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Craft in motion"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Hand-finished pieces staged like a studio campaign — direct, bold, and one of a kind.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Campaign film"
    }
  ]
}
{% endschema %}
