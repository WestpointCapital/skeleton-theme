<section class="colls section-spacing">
  {% assign regions_eyebrow = section.settings.eyebrow %}
  {% if regions_eyebrow == blank %}
    {% assign regions_eyebrow = 'collections.title' | t %}
  {% endif %}
  {% render 'section-heading',
    eyebrow: regions_eyebrow,
    heading: section.settings.heading,
    heading_italic: section.settings.heading_italic
  %}

  <div class="colls__grid">
    {% for collection in collections %}
      {% if collection.handle == 'all' %}
        {% continue %}
      {% endif %}

      {% liquid
        assign idx = forloop.index | prepend: '00' | slice: -2, 2
        assign count_key = 'collections.products_count'
        if collection.products_count == 1
          assign count_label = count_key | t: count: collection.products_count
        else
          assign count_label = count_key | t: count: collection.products_count
        endif
      %}

      <a class="colls__card" href="{{ collection.url }}" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 0.08 }}s">
        <div class="colls__media">
          {% if collection.image %}
            {{
              collection.image
              | image_url: width: 900
              | image_tag:
                class: 'colls__img',
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                alt: collection.title
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'colls__img colls__img--placeholder' }}
          {% endif %}

          <span class="colls__index meta-label">N&deg; {{ idx }}</span>

          <span class="colls__view">
            {{ 'collections.view_region' | t }}
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
              <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
        <div class="colls__info">
          <h2 class="colls__name">{{ collection.title }}</h2>
          <span class="colls__count meta-label">{{ count_label }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .colls__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }
  @media (min-width: 990px) {
    .colls__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .colls__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
  }
  .colls__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-accent-soft) 35%, var(--color-background));
  }
  .colls__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  .colls__card:hover .colls__img {
    transform: scale(1.04);
  }
  .colls__img--placeholder {
    opacity: 0.35;
    padding: 2rem;
  }

  .colls__index {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    color: var(--color-contrast);
    text-shadow: 0 1px 6px color-mix(in srgb, var(--color-navy) 40%, transparent);
  }

  .colls__view {
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-contrast);
    background: color-mix(in srgb, var(--color-navy) 72%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--duration) var(--ease), transform var(--duration) var(--ease);
  }
  .colls__card:hover .colls__view,
  .colls__card:focus-visible .colls__view {
    opacity: 1;
    transform: translateY(0);
  }

  .colls__info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .colls__name {
    font-size: var(--text-lg);
    font-weight: 400;
    margin: 0;
  }
  .colls__count { flex-shrink: 0; }

  @media (prefers-reduced-motion: reduce) {
    .colls__card:hover .colls__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic line"
    }
  ]
}
{% endschema %}
