<section class="colls section-spacing field-pearl full-width">
  <div class="colls__inner">
    {% assign drops_eyebrow = section.settings.eyebrow %}
    {% if drops_eyebrow == blank %}
      {% assign drops_eyebrow = 'collections.title' | t %}
    {% endif %}
    {% render 'section-heading',
      eyebrow: drops_eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading
    %}

    <div class="colls__grid studio-grid">
      {% for collection in collections %}
        {% if collection.handle == 'all' %}
          {% continue %}
        {% endif %}

        {% liquid
          if collection.products_count == 1
            assign count_label = 'collections.products_count' | t: count: collection.products_count
          else
            assign count_label = 'collections.products_count' | t: count: collection.products_count
          endif
        %}

        <a class="colls__card" href="{{ collection.url }}" data-cut-in style="--cut-delay: {{ forloop.index0 | times: 0.05 }}s">
          <div class="colls__media">
            {% if collection.image %}
              {{
                collection.image
                | image_url: width: 900
                | image_tag:
                  class: 'colls__img',
                  loading: 'lazy',
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                  alt: collection.title
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'colls__img colls__img--placeholder' }}
            {% endif %}

            <span class="colls__status camp-label">{{ section.settings.card_label }}</span>
          </div>
          <div class="colls__info">
            <h2 class="colls__name">{{ collection.title }}</h2>
            <span class="colls__count meta-label">{{ count_label }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .colls {
    padding: var(--section-spacing) var(--page-inline);
  }
  .colls__inner {
    display: grid;
    gap: var(--space-xl);
  }
  .colls__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 990px) {
    .colls__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .colls__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--field-ink) 4%, transparent);
    padding: var(--space-sm);
  }
  .colls__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--field-pearl);
  }
  .colls__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .colls__img--placeholder {
    opacity: 0.35;
    padding: 2rem;
  }
  .colls__status {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }
  .colls__name {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    line-height: 1;
  }
  .colls__count {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Drop archive",
  "tag": "section",
  "class": "colls-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Archive"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All drops"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every collection released as a limited studio drop."
    },
    {
      "type": "text",
      "id": "card_label",
      "label": "Card label",
      "default": "Drop"
    }
  ],
  "presets": [
    {
      "name": "Drop archive"
    }
  ]
}
{% endschema %}
