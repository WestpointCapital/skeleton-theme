<section id="AtlasNotes-{{ section.id }}" class="atlas-notes">
  <div class="atlas-notes__visual">
    <div class="atlas-notes__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 48vw, 100vw', alt: section.settings.image_alt }}
      {% elsif section.settings.fallback_image_url != blank %}
        <img src="{{ section.settings.fallback_image_url }}" alt="{{ section.settings.image_alt | escape }}" width="1200" height="1400" loading="lazy">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    {% if section.settings.image_caption != blank %}
      <p>{{ section.settings.image_caption }}</p>
    {% endif %}
  </div>

  <div class="atlas-notes__content">
    <header>
      <p class="atlas-notes__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="atlas-notes__intro">{{ section.settings.intro }}</div>
    </header>

    <ol class="atlas-notes__entries">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <span>{{ forloop.index | prepend: '0' }}</span>
          <div>
            <p>{{ block.settings.meta }}</p>
            <h3>{{ block.settings.heading }}</h3>
            <div>{{ block.settings.text }}</div>
          </div>
        </li>
      {% endfor %}
    </ol>

    {% if section.settings.link_label != blank %}
      <a class="atlas-notes__link" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label }} <span aria-hidden="true">↗</span></a>
    {% endif %}
  </div>
</section>

{% style %}
  #AtlasNotes-{{ section.id }} {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    color: var(--color-foreground);
    background: var(--color-background);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__visual {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 44rem;
    overflow: hidden;
    background: var(--color-navy);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__image,
  #AtlasNotes-{{ section.id }} .atlas-notes__image :is(img, svg) {
    width: 100%;
    height: 100%;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__image :is(img, svg) {
    display: block;
    object-fit: cover;
    opacity: .92;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__visual > p {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    max-width: 16rem;
    margin: 0;
    color: var(--color-contrast);
    font-size: .6rem;
    line-height: 1.5;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-shadow: 0 .35rem 1rem color-mix(in srgb, var(--color-navy) 50%, transparent);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__content {
    /* padding: var(--section-spacing) clamp(1.25rem, 6vw, 6.5rem); */
    padding: clamp(2rem, 1rem + 2vw, 4rem);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__eyebrow {
    margin: 0 0 1rem;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #AtlasNotes-{{ section.id }} h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.5rem, 4.8vw, 5rem);
    font-weight: 400;
    line-height: .96;
    letter-spacing: -.04em;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__intro {
    max-width: 34rem;
    margin-top: 1.75rem;
    line-height: 1.7;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries {
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries li > span,
  #AtlasNotes-{{ section.id }} .atlas-notes__entries li p {
    font-size: .6rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries li > span {
    opacity: .45;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries li p {
    margin: 0 0 .5rem;
    color: var(--color-accent);
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries h3 {
    margin: 0 0 .65rem;
    font-size: clamp(1.5rem, 2.5vw, 2.3rem);
    font-weight: 400;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__entries li div div {
    max-width: 33rem;
    font-size: .9rem;
    line-height: 1.65;
    opacity: .76;
  }
  #AtlasNotes-{{ section.id }} .atlas-notes__link {
    display: inline-block;
    margin-top: 2rem;
    color: inherit;
    font-size: .68rem;
    letter-spacing: .11em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }
  @media (max-width: 899px) {
    #AtlasNotes-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    #AtlasNotes-{{ section.id }} .atlas-notes__visual {
      position: relative;
      height: 72svh;
      min-height: 32rem;
    }
    #AtlasNotes-{{ section.id }} .atlas-notes__content {
      padding-inline: var(--page-margin);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas field notes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Behind the jewellery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every piece begins somewhere." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>We choose jewellery for more than its beauty. The materials, the maker and the place it comes from all matter.</p>" },
    { "type": "image_picker", "id": "image", "label": "Shopify image" },
    { "type": "url", "id": "fallback_image_url", "label": "Demo image URL" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Jeweller shaping a piece by hand" },
    { "type": "text", "id": "image_caption", "label": "Image caption", "default": "At the maker’s bench" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "How we choose our jewellery" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Provenance note",
      "settings": [
        { "type": "text", "id": "meta", "label": "Metadata", "default": "Materials" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Chosen for character" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We look for pearls, stones and metals with natural variation—details that make every finished piece feel individual.</p>" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Atlas field notes", "blocks": [{ "type": "note" }, { "type": "note" }, { "type": "note" }] }]
}
{% endschema %}
