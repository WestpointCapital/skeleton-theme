<section class="error-404 full-width field-navy">
  <div class="error-404__content">
    <p class="camp-label" data-cut-in>404</p>
    <h1 class="error-404__title" data-cut-in style="--cut-delay: 0.05s">
      {{ section.settings.heading | default: '404.title' | t }}
    </h1>
    <p class="error-404__text" data-cut-in style="--cut-delay: 0.1s">
      {{ section.settings.text | default: '404.not_found' | t }}
    </p>
    <a class="button button--on-dark" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" data-cut-in style="--cut-delay: 0.15s">
      {{ section.settings.button_label | default: '404.back_to_shopping' | t }}
    </a>
  </div>
</section>

{% stylesheet %}
  .error-404 {
    min-height: 70svh;
    display: grid;
    place-items: center;
    color: var(--color-contrast);
    text-align: center;
    padding: var(--section-spacing) var(--page-inline);
  }
  .error-404__content {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    max-width: 40rem;
  }
  .error-404__title {
    font-size: var(--text-display);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
  }
  .error-404__text {
    max-width: 34ch;
    color: color-mix(in srgb, var(--color-contrast) 82%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ]
}
{% endschema %}
