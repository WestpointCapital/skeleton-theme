{% comment %}
  V3 closing CTA banner — full-bleed video (or image) with inset hairline
  frame, centered italic-accent heading, and single refined action.
  Migrated to responsive-bg-video + media-controls snippet.
{% endcomment %}

{% liquid
  assign poster = section.settings.poster_url
  if section.settings.poster_image != blank
    assign poster = section.settings.poster_image | image_url: width: 2400
  endif
  if poster == blank
    assign poster = section.settings.image_url
    if section.settings.image != blank
      assign poster = section.settings.image | image_url: width: 2400
    endif
  endif

  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank or section.settings.video_mobile != blank or section.settings.video_mobile_url != blank
    assign has_video = true
  endif
%}

<section
  class="cta-banner full-width"
  style="--overlay: {{ section.settings.overlay_opacity }};"
  {% if has_video %}data-video-section{% endif %}
>
  <div class="cta-banner__media">
    {% if has_video %}
      {% render 'responsive-bg-video',
        classes: 'cta-banner__bg',
        desktop_video: section.settings.video,
        desktop_url: section.settings.video_url,
        mobile_video: section.settings.video_mobile,
        mobile_url: section.settings.video_mobile_url,
        poster: poster,
        autoplay: true,
        lazy: true
      %}
    {% else %}
      <img class="cta-banner__bg" src="{{ poster }}" alt="" loading="lazy" width="2400" height="1200">
    {% endif %}
    <div class="cta-banner__overlay"></div>
  </div>

  <div class="cta-banner__frame" aria-hidden="true"></div>

  <div class="cta-banner__content text-center">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow cta-banner__eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="cta-banner__heading" data-reveal style="--reveal-delay: 0.1s">
      {{ section.settings.heading }}
      {% if section.settings.heading_italic != blank %}
        <em>{{ section.settings.heading_italic }}</em>
      {% endif %}
    </h2>
    {% if section.settings.subheading != blank %}
      <p class="cta-banner__sub measure" data-reveal style="--reveal-delay: 0.2s">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="button button--on-dark" data-reveal style="--reveal-delay: 0.3s" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  {% if has_video and section.settings.show_controls %}
    {% render 'media-controls', autoplay: true %}
  {% endif %}
</section>

{% stylesheet %}
  .cta-banner {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 78svh;
    overflow: hidden;
    color: var(--color-contrast);
    isolation: isolate;
  }
  .cta-banner__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .cta-banner__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-banner__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-navy) calc(var(--overlay) * 1%), transparent);
  }
  .cta-banner__frame {
    position: absolute;
    inset: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--color-contrast) 35%, transparent);
    pointer-events: none;
  }
  .cta-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-3xl) var(--page-inline);
    max-width: 56rem;
  }
  .cta-banner__eyebrow {
    color: var(--color-accent-soft);
  }
  .cta-banner__heading {
    font-size: var(--text-4xl);
    font-weight: 400;
  }
  .cta-banner__sub {
    font-size: var(--text-lg);
    font-weight: 300;
    color: color-mix(in srgb, var(--color-contrast) 85%, transparent);
  }
  .cta-banner .media-controls {
    z-index: 2;
  }

  @media (max-width: 749px) {
    .cta-banner {
      min-height: 68svh;
    }
    .cta-banner__frame {
      inset: 0.9rem;
    }
    .cta-banner__content {
      padding-block: var(--space-2xl);
      gap: var(--space-sm);
    }
    .cta-banner__sub {
      font-size: var(--text-base);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video (upload)",
      "info": "Upload or pick a Shopify-hosted video. Takes priority over the URL below."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Desktop video URL (mp4)",
      "info": "Used only if no uploaded desktop video is set.",
      "default": "https://cdn.media.amplience.net/v/pandora/2026Q2D_platform_summer_con_be_ocean_motion_film02_10s_16x9_Gemini/mp4_480p"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (upload)"
    },
    {
      "type": "text",
      "id": "video_mobile_url",
      "label": "Mobile video URL (mp4)"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster / fallback image"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Poster image URL (fallback)",
      "default": "https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=2400&q=80"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (legacy)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Background image URL (legacy fallback)"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 45
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The odyssey begins"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin your"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic)",
      "default": "collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The first region has landed. Claim a piece of Oceania before it's gone forever."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the first drop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
