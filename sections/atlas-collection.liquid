{% assign atlas_collection = section.settings.collection %}

<section id="AtlasCollection-{{ section.id }}" class="atlas-collection">
  <header class="atlas-collection__header">
    <div class="atlas-collection__title">
      <p>{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="atlas-collection__legend">
      <span><b></b>{{ section.settings.legend_one }}</span>
      <span><b></b>{{ section.settings.legend_two }}</span>
    </div>
  </header>

  <div class="atlas-collection__grid">
    {% for block in section.blocks %}
      {% liquid
        assign atlas_product = block.settings.product
        if atlas_product == blank and atlas_collection != blank
          assign atlas_product = atlas_collection.products[forloop.index0]
        endif
        assign card_title = block.settings.fallback_title
        assign card_url = block.settings.link
        assign card_image = block.settings.image
        assign card_price = block.settings.fallback_price
        if atlas_product != blank
          assign card_title = atlas_product.title
          assign card_url = atlas_product.url
          assign card_image = atlas_product.featured_image
          assign card_price = atlas_product.price | money
        endif
      %}
      <article class="atlas-object" {{ block.shopify_attributes }}>
        <a class="atlas-object__media" href="{{ card_url | default: routes.all_products_collection_url }}" aria-label="{{ card_title | escape }}">
          {% if card_image != blank %}
            {{ card_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 25vw, 50vw', alt: card_title }}
          {% elsif block.settings.fallback_image_url != blank %}
            <img src="{{ block.settings.fallback_image_url }}" alt="{{ card_title | escape }}" width="800" height="1000" loading="lazy">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
          <span class="atlas-object__crosshair" aria-hidden="true"></span>
          {% if atlas_product != blank and atlas_product.available == false %}
            <span class="atlas-object__badge">{{ section.settings.sold_label }}</span>
          {% elsif block.settings.badge != blank %}
            <span class="atlas-object__badge">{{ block.settings.badge }}</span>
          {% endif %}
        </a>
        <div class="atlas-object__meta">
          <span class="atlas-object__index">OBJ. {{ forloop.index | prepend: '00' }}</span>
          <div>
            <p>{{ block.settings.origin }}</p>
            <h3><a href="{{ card_url | default: routes.all_products_collection_url }}">{{ card_title }}</a></h3>
          </div>
          <span class="atlas-object__price">{{ card_price }}</span>
        </div>
      </article>
    {% endfor %}
  </div>

  <footer class="atlas-collection__footer">
    <span>{{ section.settings.footer_note }}</span>
    {% if section.settings.link_label != blank %}
      <a href="{{ section.settings.link | default: atlas_collection.url | default: routes.all_products_collection_url }}">
        {{ section.settings.link_label }} <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </footer>
</section>

{% style %}
  #AtlasCollection-{{ section.id }} {
    padding: var(--section-spacing) max(var(--page-margin), calc((100vw - var(--page-width)) / 2));
    color: var(--color-foreground);
    background: var(--color-background);
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__title p {
    margin: 0 0 1rem;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__title h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 5.7rem);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.04em;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__legend {
    display: flex;
    gap: 1.5rem;
    padding-bottom: .5rem;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__legend span {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__legend b {
    display: block;
    width: .45rem;
    height: .45rem;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__legend span:first-child b {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-left: 1px solid var(--color-line);
  }
  #AtlasCollection-{{ section.id }} .atlas-object {
    min-width: 0;
    padding: clamp(.6rem, 1.2vw, 1rem);
    border-right: 1px solid var(--color-line);
  }
  #AtlasCollection-{{ section.id }} .atlas-object__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: inherit;
    background: color-mix(in srgb, var(--color-background) 86%, var(--color-foreground));
  }
  #AtlasCollection-{{ section.id }} .atlas-object__media :is(img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s var(--ease);
  }
  #AtlasCollection-{{ section.id }} .atlas-object__media:hover img {
    transform: scale(1.035);
  }
  #AtlasCollection-{{ section.id }} .atlas-object__crosshair::before,
  #AtlasCollection-{{ section.id }} .atlas-object__crosshair::after {
    content: "";
    position: absolute;
    z-index: 2;
    background: color-mix(in srgb, var(--color-foreground) 25%, transparent);
    pointer-events: none;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__crosshair::before {
    top: 50%;
    inset-inline: 0;
    height: 1px;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__crosshair::after {
    left: 50%;
    inset-block: 0;
    width: 1px;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__badge {
    position: absolute;
    z-index: 3;
    top: .75rem;
    right: .75rem;
    padding: .5rem .6rem;
    color: var(--color-contrast);
    background: var(--color-navy);
    font-size: .58rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: .85rem;
    align-items: start;
    padding: 1rem 0 .5rem;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__index,
  #AtlasCollection-{{ section.id }} .atlas-object__price,
  #AtlasCollection-{{ section.id }} .atlas-object__meta p {
    font-size: .6rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__index {
    opacity: .45;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta p {
    margin: 0 0 .4rem;
    color: var(--color-accent);
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta h3 {
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: .84rem;
    font-weight: 400;
    line-height: 1.35;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta a {
    color: inherit;
    text-decoration: none;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    font-size: .65rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  @media (max-width: 999px) {
    #AtlasCollection-{{ section.id }} .atlas-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    #AtlasCollection-{{ section.id }} .atlas-object {
      border-bottom: 1px solid var(--color-line);
    }
  }
  @media (max-width: 599px) {
    #AtlasCollection-{{ section.id }} .atlas-collection__header {
      align-items: start;
      flex-direction: column;
    }
    #AtlasCollection-{{ section.id }} .atlas-collection__legend {
      flex-direction: column;
      gap: .5rem;
    }
    #AtlasCollection-{{ section.id }} .atlas-object__meta {
      grid-template-columns: 1fr;
      gap: .3rem;
    }
    #AtlasCollection-{{ section.id }} .atlas-object__price {
      margin-top: .25rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collected objects · Current field selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewels with coordinates." },
    { "type": "collection", "id": "collection", "label": "Featured collection" },
    { "type": "text", "id": "legend_one", "label": "First legend", "default": "Available" },
    { "type": "text", "id": "legend_two", "label": "Second legend", "default": "One of one" },
    { "type": "text", "id": "sold_label", "label": "Sold out label", "default": "Archived" },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "All objects are documented and dispatched with provenance notes." },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "View complete catalogue" },
    { "type": "url", "id": "link", "label": "Collection link" }
  ],
  "blocks": [
    {
      "type": "object",
      "name": "Atlas object",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Fallback Shopify image" },
        { "type": "url", "id": "fallback_image_url", "label": "Demo image URL" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Uncatalogued object" },
        { "type": "text", "id": "fallback_price", "label": "Fallback price", "default": "Price on request" },
        { "type": "text", "id": "origin", "label": "Origin", "default": "South Pacific · 17° S" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "One of one" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Atlas collection", "blocks": [{ "type": "object" }, { "type": "object" }, { "type": "object" }, { "type": "object" }] }]
}
{% endschema %}
