{% assign atlas_collection = section.settings.collection %}

<section id="AtlasCollection-{{ section.id }}" class="atlas-collection">
  <header class="atlas-collection__header">
    <div class="atlas-collection__title">
      <p>{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.link_label != blank %}
      <a class="atlas-collection__header-link" href="{{ section.settings.link | default: atlas_collection.url | default: routes.all_products_collection_url }}">
        {{ section.settings.link_label }} <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </header>

  <div class="atlas-collection__grid">
    {% for block in section.blocks %}
      {% liquid
        assign atlas_product = block.settings.product
        if atlas_product == blank and atlas_collection != blank
          assign atlas_product = atlas_collection.products[forloop.index0]
        endif
        assign card_title = block.settings.fallback_title
        assign card_url = block.settings.link
        assign card_image = block.settings.image
        assign card_price = block.settings.fallback_price
        if atlas_product != blank
          assign card_title = atlas_product.title
          assign card_url = atlas_product.url
          assign card_image = atlas_product.featured_image
          assign card_price = atlas_product.price | money
        endif
      %}
      <article class="atlas-object" {{ block.shopify_attributes }}>
        <a class="atlas-object__media" href="{{ card_url | default: routes.all_products_collection_url }}" aria-label="{{ card_title | escape }}">
          {% if card_image != blank %}
            {{ card_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 900px) 25vw, 50vw', alt: card_title }}
          {% elsif block.settings.fallback_image_url != blank %}
            <img src="{{ block.settings.fallback_image_url }}" alt="{{ card_title | escape }}" width="800" height="1000" loading="lazy">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
          {% if atlas_product != blank and atlas_product.available == false %}
            <span class="atlas-object__badge">{{ section.settings.sold_label }}</span>
          {% elsif block.settings.badge != blank %}
            <span class="atlas-object__badge">{{ block.settings.badge }}</span>
          {% endif %}
        </a>
        <div class="atlas-object__meta">
          {% if block.settings.origin != blank %}
            <p>{{ block.settings.origin }}</p>
          {% endif %}
          <h3><a href="{{ card_url | default: routes.all_products_collection_url }}">{{ card_title }}</a></h3>
          <span class="atlas-object__price">{{ card_price }}</span>
        </div>
      </article>
    {% endfor %}
  </div>

  {% if section.settings.footer_note != blank %}
    <footer class="atlas-collection__footer">
      <span>{{ section.settings.footer_note }}</span>
    </footer>
  {% endif %}
</section>

{% style %}
  #AtlasCollection-{{ section.id }} {
    /* padding: var(--section-spacing) max(var(--page-margin), calc((100vw - var(--page-width)) / 2)); */
    padding: clamp(2rem, 1rem + 2vw, 4rem);
    color: var(--color-foreground);
    background: var(--color-background);
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__title p {
    margin: 0 0 1rem;
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__title h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.6rem, 4.8vw, 5rem);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.04em;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__header-link {
    flex-shrink: 0;
    margin-bottom: .4rem;
    color: inherit;
    font-size: .65rem;
    letter-spacing: .11em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }
  #AtlasCollection-{{ section.id }} .atlas-object {
    min-width: 0;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: inherit;
    background: color-mix(in srgb, var(--color-background) 90%, var(--color-foreground));
  }
  #AtlasCollection-{{ section.id }} .atlas-object__media :is(img, svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s var(--ease);
  }
  #AtlasCollection-{{ section.id }} .atlas-object__media:hover img {
    transform: scale(1.03);
  }
  #AtlasCollection-{{ section.id }} .atlas-object__badge {
    position: absolute;
    top: .85rem;
    left: .85rem;
    padding: .45rem .55rem;
    color: var(--color-contrast);
    background: var(--color-navy);
    font-size: .55rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta {
    padding-top: 1.15rem;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta p {
    margin: 0 0 .45rem;
    color: var(--color-accent);
    font-size: .58rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta h3 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.15rem, 1.4vw, 1.45rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -.01em;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__meta a {
    color: inherit;
    text-decoration: none;
  }
  #AtlasCollection-{{ section.id }} .atlas-object__price {
    display: block;
    margin-top: .65rem;
    font-size: .72rem;
    letter-spacing: .04em;
    opacity: .72;
  }
  #AtlasCollection-{{ section.id }} .atlas-collection__footer {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .65;
  }
  @media (max-width: 999px) {
    #AtlasCollection-{{ section.id }} .atlas-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    #AtlasCollection-{{ section.id }} .atlas-collection__header {
      align-items: start;
      flex-direction: column;
      gap: 1.25rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Current selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces from around the world." },
    { "type": "collection", "id": "collection", "label": "Featured collection" },
    { "type": "text", "id": "sold_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "Selected for their beauty, craftsmanship and connection to place." },
    { "type": "text", "id": "link_label", "label": "Collection link label", "default": "Shop all jewellery" },
    { "type": "url", "id": "link", "label": "Collection link" }
  ],
  "blocks": [
    {
      "type": "object",
      "name": "Atlas object",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Fallback Shopify image" },
        { "type": "url", "id": "fallback_image_url", "label": "Demo image URL" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Handmade jewellery" },
        { "type": "text", "id": "fallback_price", "label": "Fallback price", "default": "Price on request" },
        { "type": "text", "id": "origin", "label": "Origin", "default": "Oceania" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Atlas collection", "blocks": [{ "type": "object" }, { "type": "object" }, { "type": "object" }, { "type": "object" }] }]
}
{% endschema %}
