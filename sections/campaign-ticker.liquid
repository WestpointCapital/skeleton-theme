{% comment %}
  Campaign ticker — bold drop information strip.
{% endcomment %}

<section class="camp-ticker full-width field-{{ section.settings.field_color }}" aria-label="{{ section.settings.aria_label }}">
  <div class="camp-ticker__track" data-cut-in>
    {% for block in section.blocks %}
      <span class="camp-ticker__item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {% else %}
          {{ block.settings.text }}
        {% endif %}
      </span>
      {% unless forloop.last %}
        <span class="camp-ticker__sep" aria-hidden="true">—</span>
      {% endunless %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .camp-ticker {
    padding: 1rem var(--page-inline);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .camp-ticker::-webkit-scrollbar {
    display: none;
  }
  .camp-ticker__track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    white-space: nowrap;
    min-width: max-content;
  }
  .camp-ticker__item {
    font-family: var(--font-display--family);
    font-size: clamp(1rem, 0.8rem + 1.2vw, 1.35rem);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
  }
  .camp-ticker__item a {
    text-decoration: none;
    color: inherit;
  }
  .camp-ticker__item a:hover {
    color: var(--color-accent-soft);
  }
  .camp-ticker__sep {
    opacity: 0.45;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign ticker",
  "tag": "section",
  "class": "camp-ticker-section",
  "settings": [
    {
      "type": "select",
      "id": "field_color",
      "label": "Background",
      "options": [
        { "value": "rose", "label": "Rose" },
        { "value": "navy", "label": "Navy" },
        { "value": "pearl", "label": "Pearl" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "rose"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Current drop information"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Oceania — Live now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Oceania — Live now" } },
        { "type": "item", "settings": { "text": "Limited release" } },
        { "type": "item", "settings": { "text": "One of a kind" } }
      ]
    }
  ]
}
{% endschema %}
