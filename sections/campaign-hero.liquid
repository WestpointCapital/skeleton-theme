{% comment %}
  Campaign hero — full-screen film with solid typography module.
{% endcomment %}

<section class="camp-hero full-width field-ink" id="CampaignHero-{{ section.id }}">
  <div class="camp-hero__media">
    {% render 'responsive-bg-video',
      classes: 'camp-hero__video',
      desktop_url: section.settings.video_url,
      mobile_url: section.settings.video_mobile_url,
      poster: section.settings.poster_url,
      autoplay: true
    %}
    {% if section.settings.show_controls %}
      {% render 'media-controls' %}
    {% endif %}
  </div>

  <div class="camp-hero__module field-{{ section.settings.module_color }}">
    {% render 'campaign-heading',
      label: section.settings.label,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      heading_tag: 'h1'
    %}
    {% if section.settings.button_label != blank %}
      {% liquid
        assign btn_url = section.settings.button_url
        if btn_url == blank and section.settings.collection != blank
          assign btn_url = section.settings.collection.url
        endif
      %}
      <a class="button{% if section.settings.module_color == 'pearl' %} button--on-dark{% else %} button--on-dark{% endif %}" href="{{ btn_url | default: routes.all_products_collection_url }}" data-cut-in style="--cut-delay: 0.15s">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .camp-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }
  .camp-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .camp-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .camp-hero__module {
    position: relative;
    z-index: 2;
    align-self: end;
    margin: var(--page-inline);
    margin-bottom: clamp(2rem, 4vw, 4rem);
    padding: clamp(1.5rem, 2vw, 2.5rem);
    max-width: min(42rem, calc(100% - 2rem));
    display: grid;
    gap: var(--space-md);
  }
  .camp-hero__module .camp-head__title {
    font-size: var(--text-campaign);
  }
  .camp-hero__module.field-pearl .camp-label {
    background: var(--field-navy);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign hero",
  "tag": "section",
  "class": "camp-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Desktop video URL",
      "default": "https://cdn.media.amplience.net/v/pandora/2026Q2D_platform_summer_awa_be_essence_motion_film06_10s_16x9_Gemini/mp4_720p"
    },
    {
      "type": "text",
      "id": "video_mobile_url",
      "label": "Mobile video URL"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Poster image URL",
      "default": "https://images.unsplash.com/photo-1505142468610-359e7d316be0?auto=format&fit=crop&w=2400&q=80"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "select",
      "id": "module_color",
      "label": "Typography module color",
      "options": [
        { "value": "navy", "label": "Navy" },
        { "value": "rose", "label": "Rose" },
        { "value": "pearl", "label": "Pearl" }
      ],
      "default": "navy"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Drop 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oceania"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "One-of-a-kind pieces. Limited release."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    }
  ],
  "presets": [
    {
      "name": "Campaign hero"
    }
  ]
}
{% endschema %}
