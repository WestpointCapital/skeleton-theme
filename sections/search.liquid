{% liquid
  assign per_page = section.settings.results_per_page | default: 24
%}

<section class="search-page section-spacing">
  <div class="search-page__head">
    <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

    <div class="search-page__form-wrap" data-predictive-search>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
        <input
          class="search-page__input field__input"
          type="search"
          id="SearchInput-{{ section.id }}"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          data-search-input
          autocomplete="off"
          spellcheck="false"
        >
        <input type="hidden" name="type" value="product,article,page">
        <button class="search-page__submit button" type="submit">
          {{ 'search.submit' | t }}
        </button>
      </form>
      <div class="search-page__predictions" data-search-results hidden></div>
    </div>
  </div>

  {% if search.performed %}
    {% paginate search.results by per_page %}
      {% if search.results_count > 0 %}
        <p class="search-page__count" data-reveal>
          {{ 'search.results_for_html' | t: count: search.results_count, terms: search.terms }}
        </p>

        {% liquid
          assign product_results = search.results | where: 'object_type', 'product'
          assign article_results = search.results | where: 'object_type', 'article'
          assign page_results = search.results | where: 'object_type', 'page'
        %}

        {% if product_results.size > 0 %}
          <div class="search-page__group" data-reveal>
            <h2 class="search-page__group-title">{{ 'search.products' | t }}</h2>
            <div class="product-grid">
              {% for item in product_results %}
                {% render 'product-card', product: item %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% if article_results.size > 0 %}
          <div class="search-page__group" data-reveal>
            <h2 class="search-page__group-title">{{ 'search.articles' | t }}</h2>
            <ul class="search-page__list">
              {% for item in article_results %}
                <li class="search-page__list-item">
                  <a href="{{ item.url }}">
                    {% if item.image %}
                      <div class="search-page__list-media">
                        {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px' }}
                      </div>
                    {% endif %}
                    <div>
                      <span class="search-page__list-title">{{ item.title }}</span>
                      {% if item.content != blank %}
                        <p class="search-page__list-excerpt">{{ item.content | strip_html | truncatewords: 18 }}</p>
                      {% endif %}
                    </div>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if page_results.size > 0 %}
          <div class="search-page__group" data-reveal>
            <h2 class="search-page__group-title">{{ 'search.pages' | t }}</h2>
            <ul class="search-page__list">
              {% for item in page_results %}
                <li class="search-page__list-item">
                  <a href="{{ item.url }}">
                    <div>
                      <span class="search-page__list-title">{{ item.title }}</span>
                      {% if item.content != blank %}
                        <p class="search-page__list-excerpt">{{ item.content | strip_html | truncatewords: 18 }}</p>
                      {% endif %}
                    </div>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% render 'pagination', paginate: paginate %}
      {% else %}
        <div class="search-page__empty" data-reveal>
          <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
          <a class="button button--ghost" href="{{ routes.all_products_collection_url }}">
            {{ 'general.continue_shopping' | t }}
          </a>
        </div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% stylesheet %}
  .search-page__head {
    margin-bottom: var(--space-xl);
    text-align: center;
  }
  .search-page__title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    font-weight: 400;
    margin-bottom: var(--space-lg);
  }

  .search-page__form-wrap {
    position: relative;
    max-width: 38rem;
    margin-inline: auto;
  }
  .search-page__form {
    display: flex;
    gap: 0;
  }
  .search-page__input {
    flex: 1;
    border-right: 0;
    font-size: var(--text-base);
    padding: 1rem 1.25rem;
  }
  .search-page__submit {
    flex-shrink: 0;
  }
  .search-page__predictions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    background: var(--color-background);
    border: 1px solid var(--color-line);
    border-top: 0;
    box-shadow: 0 12px 40px color-mix(in srgb, var(--color-navy) 10%, transparent);
    max-height: 24rem;
    overflow-y: auto;
  }

  .search-page__count {
    font-size: var(--text-sm);
    color: var(--color-foreground-50);
    margin-bottom: var(--space-lg);
  }

  .search-page__group {
    margin-bottom: var(--space-xl);
  }
  .search-page__group-title {
    font-size: var(--text-xl);
    font-weight: 400;
    margin-bottom: var(--space-md);
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-line);
  }

  .search-page__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
  }
  .search-page__list-item a {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color var(--duration) var(--ease);
  }
  .search-page__list-item a:hover {
    color: var(--color-accent);
  }
  .search-page__list-media {
    flex-shrink: 0;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-accent-soft) 25%, var(--color-background));
  }
  .search-page__list-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .search-page__list-title {
    display: block;
    font-family: var(--font-heading--family);
    font-size: var(--text-lg);
  }
  .search-page__list-excerpt {
    font-size: var(--text-sm);
    color: var(--color-foreground-50);
    margin-top: 0.25rem;
  }

  .search-page__empty {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
    padding: var(--space-xl) 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 24
    }
  ]
}
{% endschema %}
