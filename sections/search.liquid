<section class="oj-search">
  <header class="oj-search__header">
    <p>{{ section.settings.kicker }}</p>
    <h1>{{ 'search.title' | t }}</h1>
    <form class="oj-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'search.title' | t }}</label>
      <input
        id="Search-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocorrect="off"
        autocomplete="off"
      >
      <button type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>

  {% if search.performed %}
    <div class="oj-search__status" role="status">
      {% if search.results_count == 0 %}
        <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {% else %}
        <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
      {% endif %}
    </div>

    {% if search.results_count > 0 %}
      {% paginate search.results by section.settings.results_per_page %}
        <div class="oj-search__grid">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result, show_vendor: section.settings.show_vendor, show_excerpt: false, lazy: true %}
            {% else %}
              {% assign featured_image = result.featured_image | default: result.image %}
              <article class="oj-search-card">
                <a class="oj-search-card__media" href="{{ result.url }}">
                  {% if featured_image %}
                    {{
                      featured_image
                      | image_url: width: 900
                      | image_tag: widths: '320, 480, 700, 900', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy'
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'oj-search-card__placeholder' }}
                  {% endif %}
                </a>
                <div class="oj-search-card__content">
                  <p>{{ result.object_type }}</p>
                  <h2><a href="{{ result.url }}">{{ result.title }}</a></h2>
                  {% if result.content != blank %}
                    <div>{{ result.content | strip_html | truncatewords: 24 }}</div>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <nav class="oj-search__pagination" aria-label="{{ section.settings.pagination_label }}">
          {{ paginate | default_pagination }}
        </nav>
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>

{% stylesheet %}
  .oj-search {
    padding: clamp(3rem, 8vw, 8rem) clamp(1rem, 5vw, 5rem);
    color: var(--color-foreground);
  }

  .oj-search__header {
    max-width: 78rem;
  }

  .oj-search__header > p {
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .oj-search__header h1 {
    margin: 0.3rem 0 2rem;
    font-size: clamp(4rem, 11vw, 11rem);
    line-height: 0.83;
  }

  .oj-search__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border-bottom: 1px solid var(--color-foreground);
  }

  .oj-search__form input,
  .oj-search__form button {
    min-height: 4rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .oj-search__form input {
    min-width: 0;
    font-size: clamp(1.2rem, 3vw, 2rem);
  }

  .oj-search__form button {
    padding-inline: 1rem;
    cursor: pointer;
  }

  .oj-search__status {
    margin: 3rem 0 2rem;
  }

  .oj-search__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 3rem);
  }

  .oj-search-card__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-foreground-12);
  }

  .oj-search-card__media img,
  .oj-search-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .oj-search-card__content {
    padding: 1rem 0;
  }

  .oj-search-card__content > p {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .oj-search-card h2 {
    margin: 0.4rem 0 0.8rem;
  }

  .oj-search-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .oj-search__pagination {
    margin-top: 4rem;
    text-align: center;
  }

  @media (max-width: 850px) {
    .oj-search__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .oj-search__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Search the atlas" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show maker", "default": true },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 40, "step": 4, "default": 20 },
    { "type": "text", "id": "pagination_label", "label": "Pagination label", "default": "Search result pages" }
  ]
}
{% endschema %}
