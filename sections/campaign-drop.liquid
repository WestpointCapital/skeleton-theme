{% comment %}
  Campaign drop — rigid color-field product composition.
{% endcomment %}

{% liquid
  assign collection = section.settings.collection
  assign products = collection.products
  assign limit = section.settings.products_to_show
%}

<section class="camp-drop full-width field-{{ section.settings.field_color }}">
  <div class="camp-drop__inner">
    <div class="camp-drop__head">
      {% render 'campaign-heading',
        label: section.settings.label,
        heading: section.settings.heading,
        subheading: section.settings.subheading
      %}
      {% if section.settings.link_label != blank %}
        {% liquid
          assign link_url = section.settings.link_url
          if link_url == blank and collection != blank
            assign link_url = collection.url
          endif
        %}
        <a class="link-underline camp-drop__link" href="{{ link_url | default: routes.all_products_collection_url }}" data-cut-in>
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </div>

    <div class="camp-drop__grid studio-grid">
      {% if collection != blank and products.size > 0 %}
        {% for product in products limit: limit %}
          <div class="camp-drop__cell" data-cut-in style="--cut-delay: {{ forloop.index0 | times: 0.05 }}s">
            {% render 'campaign-product', product: product, drop_label: section.settings.drop_label, lazy: forloop.index > 2 %}
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..limit) %}
          <div class="camp-drop__cell camp-drop__cell--placeholder" data-cut-in>
            <div class="camp-drop__placeholder-stage">
              {{ 'product-' | append: i | placeholder_svg_tag: 'camp-drop__placeholder-img' }}
            </div>
            <div class="camp-drop__placeholder-meta">
              <span class="camp-drop__placeholder-drop">{{ section.settings.drop_label }}</span>
              <p class="camp-drop__placeholder-title">Sample piece {{ i }}</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .camp-drop {
    padding: var(--section-spacing) var(--page-inline);
  }
  .camp-drop__inner {
    display: grid;
    gap: var(--space-xl);
  }
  .camp-drop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .camp-drop__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 750px) {
    .camp-drop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .camp-drop__cell {
    background: color-mix(in srgb, var(--color-contrast) 6%, transparent);
    padding: var(--space-sm);
  }
  .field-pearl .camp-drop__cell {
    background: color-mix(in srgb, var(--field-ink) 4%, transparent);
  }
  .camp-drop.field-pearl .camp-label {
    background: var(--field-rose);
  }
  .camp-drop__placeholder-stage {
    aspect-ratio: 3 / 4;
    background: var(--field-pearl);
    overflow: hidden;
  }
  .camp-drop__placeholder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .camp-drop__placeholder-meta {
    display: grid;
    gap: 0.35rem;
    padding-top: var(--space-sm);
  }
  .camp-drop__placeholder-drop {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .camp-drop__placeholder-title {
    margin: 0;
    font-family: var(--font-display--family);
    font-size: var(--text-lg);
    font-weight: 600;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign drop",
  "tag": "section",
  "class": "camp-drop-section",
  "settings": [
    {
      "type": "select",
      "id": "field_color",
      "label": "Background",
      "options": [
        { "value": "pearl", "label": "Pearl" },
        { "value": "navy", "label": "Navy" },
        { "value": "rose", "label": "Rose" }
      ],
      "default": "pearl"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oceania"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Studio-staged pieces from the first collection."
    },
    {
      "type": "text",
      "id": "drop_label",
      "label": "Product drop label",
      "default": "Oceania"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View full drop"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Campaign drop"
    }
  ]
}
{% endschema %}
