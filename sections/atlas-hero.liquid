{% liquid
  assign hero_image = section.settings.image
  assign hero_alt = section.settings.image_alt | default: section.settings.heading
  assign poster = section.settings.fallback_image_url
  if hero_image != blank
    assign poster = hero_image | image_url: width: 1800
  endif

  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
%}

<section
  id="AtlasHero-{{ section.id }}"
  class="atlas-hero"
  {% if has_video %}data-video-section{% endif %}
>
  <div class="atlas-hero__content">
    <div class="atlas-hero__copy">
      {% if section.settings.kicker != blank %}
        <p class="atlas-hero__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      <h1>
        {{ section.settings.heading }}
        {% if section.settings.heading_italic != blank %}
          <em>{{ section.settings.heading_italic }}</em>
        {% endif %}
      </h1>
      {% if section.settings.text != blank %}
        <div class="atlas-hero__text">{{ section.settings.text }}</div>
      {% endif %}
      <div class="atlas-hero__actions">
        {% if section.settings.button_label != blank %}
          <a class="atlas-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="atlas-hero__text-link" href="{{ section.settings.secondary_link | default: '#AtlasRegions' }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="atlas-hero__visual">
    <div class="atlas-hero__media">
      {% if has_video %}
        {% render 'responsive-bg-video',
          classes: 'atlas-hero__video',
          desktop_video: section.settings.video,
          desktop_url: section.settings.video_url,
          poster: poster,
          autoplay: true
        %}
      {% elsif hero_image != blank %}
        {{ hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800', sizes: '(min-width: 900px) 55vw, 100vw', alt: hero_alt }}
      {% elsif section.settings.fallback_image_url != blank %}
        <img src="{{ section.settings.fallback_image_url }}" alt="{{ hero_alt | escape }}" width="1200" height="1500" loading="eager" fetchpriority="high">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'atlas-hero__placeholder' }}
      {% endif %}
    </div>
    {% if section.settings.caption != blank %}
      <p class="atlas-hero__caption">{{ section.settings.caption }}</p>
    {% endif %}
  </div>
</section>

{% style %}
  #AtlasHero-{{ section.id }} {
    min-height: min(820px, calc(100svh - var(--header-height, 5.5rem)));
    display: grid;
    grid-template-columns: minmax(0, .45fr) minmax(0, .55fr);
    color: var(--color-foreground);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(3.5rem, 7vw, 7rem) clamp(1.5rem, 5vw, 5rem) clamp(3rem, 6vw, 6rem);
  }
  #AtlasHero-{{ section.id }} .atlas-hero__copy {
    max-width: 28rem;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__kicker {
    margin: 0 0 1.75rem;
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  #AtlasHero-{{ section.id }} h1 {
    margin: 0;
    font-size: clamp(3.4rem, 6.8vw, 6.8rem);
    font-weight: 400;
    line-height: .92;
    letter-spacing: -.045em;
  }
  #AtlasHero-{{ section.id }} h1 em {
    display: block;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -.03em;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__text {
    max-width: 28rem;
    margin-top: 1.75rem;
    font-size: clamp(.95rem, 1.1vw, 1.05rem);
    line-height: 1.7;
    opacity: .78;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__button,
  #AtlasHero-{{ section.id }} .atlas-hero__text-link {
    color: inherit;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__button {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    min-width: 12.5rem;
    gap: 2rem;
    padding: 1rem 1.15rem;
    color: var(--color-contrast);
    background: var(--color-navy);
    border: 1px solid var(--color-navy);
    transition: background .25s ease, color .25s ease;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__button:hover {
    color: var(--color-navy);
    background: transparent;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__text-link {
    border-bottom: 1px solid currentColor;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__visual {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--color-navy);
  }
  #AtlasHero-{{ section.id }} .atlas-hero__media {
    position: relative;
    width: 100%;
    height: 100%;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__media :is(img, video, svg) {
    width: 100%;
    height: 100%;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__media :is(img, video) {
    display: block;
    object-fit: cover;
  }
  #AtlasHero-{{ section.id }} .atlas-hero__caption {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    max-width: 14rem;
    margin: 0;
    color: var(--color-contrast);
    font-size: .62rem;
    line-height: 1.5;
    letter-spacing: .1em;
    text-align: right;
    text-transform: uppercase;
    text-shadow: 0 .4rem 1.2rem color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  @media (max-width: 899px) {
    #AtlasHero-{{ section.id }} {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    #AtlasHero-{{ section.id }} .atlas-hero__content {
      padding: clamp(3rem, 8vw, 4.5rem) var(--page-margin) clamp(2.5rem, 6vw, 3.5rem);
    }
    #AtlasHero-{{ section.id }} .atlas-hero__copy {
      max-width: none;
    }
    #AtlasHero-{{ section.id }} .atlas-hero__visual {
      min-height: 68svh;
      order: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #AtlasHero-{{ section.id }} video {
      display: none;
    }
    #AtlasHero-{{ section.id }} .atlas-hero__media::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        {% if poster != blank %}url({{ poster | escape }}) center / cover no-repeat{% else %}var(--color-navy){% endif %};
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Atlas hero",
  "tag": "section",
  "class": "atlas-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Odyssey Jewels" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collect the world" },
    { "type": "text", "id": "heading_italic", "label": "Heading second line", "default": "One piece at a time." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Jewellery chosen from makers around the world, with each piece reflecting the materials, traditions and character of where it was made.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop jewellery" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Explore by place" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "url", "id": "video_url", "label": "Demo video URL (mp4)" },
    { "type": "image_picker", "id": "image", "label": "Poster / fallback image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Handcrafted jewellery photographed on natural stone" },
    { "type": "url", "id": "fallback_image_url", "label": "Demo image URL" },
    { "type": "text", "id": "caption", "label": "Media caption", "default": "Made by hand, found around the world" }
  ],
  "presets": [{ "name": "Atlas hero" }]
}
{% endschema %}
