<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    <meta name="theme-color" content="{{ settings.color_navy }}">
    {% style %}
      .template-password {
        min-height: 100svh;
      }

      .template-password main {
        min-height: 100svh;
      }

      .password-skip {
        position: fixed;
        top: 0;
        left: var(--page-margin);
        z-index: 20;
        padding: var(--space-sm);
        color: var(--color-navy);
        background: var(--color-contrast);
        transform: translateY(-110%);
      }

      .password-skip:focus {
        transform: translateY(0);
      }
    {% endstyle %}
    {{ content_for_header }}
  </head>

  <body class="template-password">
    <a class="password-skip" href="#PasswordMain">{{ 'general.skip_to_content' | t }}</a>
    <main id="PasswordMain" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
