{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    {% style %}
      body {
        min-height: 100svh;
        background:
          radial-gradient(circle at 15% 20%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 28rem),
          var(--color-background);
      }

      .gift-card-page {
        display: grid;
        place-items: center;
        min-height: 100svh;
        padding: var(--space-xl) var(--page-margin);
      }

      .gift-card {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
        width: min(100%, 68rem);
        overflow: hidden;
        border: 1px solid var(--color-line);
        box-shadow: 0 2rem 5rem color-mix(in srgb, var(--color-navy) 12%, transparent);
      }

      .gift-card__visual {
        position: relative;
        display: flex;
        min-height: 38rem;
        padding: var(--space-xl);
        overflow: hidden;
        color: var(--color-contrast);
        background: var(--color-navy);
      }

      .gift-card__visual::before,
      .gift-card__visual::after {
        position: absolute;
        content: "";
        border: 1px solid color-mix(in srgb, var(--color-accent-soft) 25%, transparent);
        border-radius: 50%;
      }

      .gift-card__visual::before {
        inset: -25% -10% 35% -40%;
      }

      .gift-card__visual::after {
        inset: 30% -45% -20% 20%;
      }

      .gift-card__brand {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 100%;
      }

      .gift-card__logo {
        width: min(14rem, 60%);
        max-height: 7rem;
        object-fit: contain;
        object-position: left center;
      }

      .gift-card__wordmark {
        font-family: var(--font-heading--family);
        font-size: var(--text-2xl);
        font-style: italic;
      }

      .gift-card__mark {
        color: var(--color-accent-soft);
        font-family: var(--font-heading--family);
        font-size: clamp(7rem, 18vw, 13rem);
        font-style: italic;
        line-height: 0.7;
        opacity: 0.9;
      }

      .gift-card__tagline {
        max-width: 24ch;
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
      }

      .gift-card__details {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 6vw, 5rem);
        background: var(--color-background);
      }

      .gift-card__details h1 {
        margin-block: var(--space-md) var(--space-xs);
        font-size: var(--text-4xl);
      }

      .gift-card__status {
        margin-bottom: var(--space-sm);
        color: var(--color-accent);
        font-weight: 600;
      }

      .gift-card__code {
        margin-top: var(--space-lg);
        padding: var(--space-md);
        border: 1px solid var(--color-line);
        font-size: var(--text-lg);
        letter-spacing: 0.16em;
        text-align: center;
        overflow-wrap: anywhere;
        user-select: all;
      }

      .gift-card__wallet {
        display: inline-block;
        width: 10rem;
        margin-top: var(--space-lg);
      }

      .gift-card__wallet img {
        width: 100%;
      }

      .gift-card__shop {
        margin-top: var(--space-lg);
      }

      @media (max-width: 749px) {
        .gift-card-page {
          align-items: start;
          padding-block: var(--space-md);
        }

        .gift-card {
          grid-template-columns: 1fr;
        }

        .gift-card__visual {
          min-height: 25rem;
        }
      }

      @media print {
        .gift-card-page {
          padding: 0;
        }

        .gift-card {
          box-shadow: none;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main class="gift-card-page">
      <article class="gift-card" aria-labelledby="gift-card-title">
        <div class="gift-card__visual">
          <div class="gift-card__brand">
            {% assign brand_logo = shop.brand.logo %}
            {% if brand_logo != blank %}
              {{
                brand_logo
                | image_url: width: 600
                | image_tag: widths: '240, 400, 600', class: 'gift-card__logo', alt: shop.name
              }}
            {% else %}
              <span class="gift-card__wordmark">{{ shop.name | escape }}</span>
            {% endif %}
            <span class="gift-card__mark" aria-hidden="true">OJ</span>
            <p class="gift-card__tagline">{{ 'gift_card.tagline' | t }}</p>
          </div>
        </div>

        <div class="gift-card__details">
          <p class="eyebrow eyebrow--rule">{{ 'gift_card.eyebrow' | t }}</p>
          <h1 id="gift-card-title">{{ gift_card.balance | money }}</h1>

          {% if gift_card.enabled == false or gift_card.expired %}
            <p class="gift-card__status" role="status">{{ 'gift_card.expired' | t }}</p>
          {% endif %}

          {% if gift_card.expires_on %}
            {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
            <p>{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
          {% endif %}

          <p>{{ 'gift_card.use_at_checkout' | t }}</p>
          <div class="gift-card__code" aria-label="{{ 'gift_card.code_label' | t }}">
            {{ gift_card.code | format_code }}
          </div>

          {% if gift_card.pass_url %}
            <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                width="200"
                height="60"
              >
            </a>
          {% endif %}

          <a class="gift-card__shop button" href="{{ shop.url }}">{{ 'gift_card.shop_now' | t }}</a>
        </div>
      </article>
    </main>
  </body>
</html>
