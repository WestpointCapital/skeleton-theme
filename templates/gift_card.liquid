{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {% unless settings.type_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    {{ content_for_header }}
    <style>
      body {
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background: var(--color-background);
      }
      .gift-card {
        width: min(28rem, 100%);
        text-align: center;
        display: grid;
        gap: 1.25rem;
        padding: 2.5rem 1.75rem;
        background: var(--color-navy);
        color: var(--color-contrast);
        border: 1px solid color-mix(in srgb, var(--color-accent-soft) 35%, transparent);
      }
      .gift-card__logo {
        margin-inline: auto;
        max-width: 8rem;
      }
      .gift-card__balance {
        font-family: var(--font-heading--family);
        font-size: clamp(2.5rem, 2rem + 3vw, 4rem);
        font-weight: 400;
        line-height: 1;
      }
      .gift-card__code {
        font-size: 1.1rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent-soft);
      }
      .gift-card__meta {
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.75;
      }
      .gift-card img {
        margin-inline: auto;
      }
    </style>
  </head>
  <body>
    <main class="gift-card" role="main">
      {% if settings.logo != blank %}
        {{
          settings.logo
          | image_url: width: 300
          | image_tag: class: 'gift-card__logo', alt: shop.name, loading: 'eager'
        }}
      {% else %}
        <p class="eyebrow">{{ shop.name }}</p>
      {% endif %}

      <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
      {% assign balance = gift_card.balance | money %}
      <p class="gift-card__meta">{{ 'gift_card.remaining_html' | t: balance: balance }}</p>

      {% if gift_card.enabled == false or gift_card.expired %}
        <p>{{ 'gift_card.expired' | t }}</p>
      {% endif %}

      {% if gift_card.expires_on %}
        {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
        <p class="gift-card__meta">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {% endif %}

      <p>{{ 'gift_card.use_at_checkout' | t }}</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="180"
            height="54"
            loading="lazy"
          >
        </a>
      {% endif %}
    </main>
  </body>
</html>
